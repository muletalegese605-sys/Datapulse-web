async function doLogin(e) {
  e.preventDefault();
  const rl = DP.security.checkRateLimit();
  if (rl.blocked) { document.getElementById('loginRateMsg').textContent = `Too many attempts. Wait ${rl.wait}s`; return; }
  document.getElementById('loginRateMsg').textContent = '';
  const email = document.getElementById('loginEmail').value.trim().toLowerCase();
  const pw = document.getElementById('loginPass').value;
  if (!email || !pw) { DP.security.recordAttempt(); toast('Fill all fields','error'); return; }
  if (!DP.validators.email(email)) { toast('Invalid email format','error'); return; }
  const lock = DP.security.lockout.check(email);
  if (lock.locked) { toast(`Account locked. Try again in ${lock.remaining} min.`, 'error'); return; }
  const btn = e.target.querySelector('button[type="submit"]');
  btn.disabled = true; const orig = btn.innerHTML;
  btn.innerHTML = '<i class="fa-solid fa-spinner spin mr-2"></i>Signing in…';
  try {
    let org = null;
    if (firebaseReady) {
      const u = await fbLogin(email, pw);
      org = await fbLoadOrg(u.uid) || state.orgs.find(o => o.email === email);
      if (!org) throw new Error('Organization not found. Please register.');
      const recs = await fbLoadRecords(org.id);
      if (recs) state.records = recs;
      state.user = { email, name: org.name, role: org.email===ADMIN_EMAIL?'admin':'user', uid:u.uid };
      state.org = org;
    } else {
      org = state.orgs.find(o => o.email === email);
      if (!org) throw new Error('Organization not found. Please register first.');
      if (org.passwordHash) {
        const ok = await DP.bcrypt.verify(pw, org.passwordHash);
        if (!ok) { DP.security.lockout.recordFail(email); const l = DP.security.lockout.check(email); if (l.locked) throw new Error(`Account locked for 30 min after 5 failed attempts.`); throw new Error('Invalid email or password.'); }
      } else throw new Error('Please register again — password hash missing.');
      state.records = DP.LS.get('dp_records_'+org.id, []);
      state.user = { email, name: org.name, role: org.email===ADMIN_EMAIL?'admin':'user' };
      state.org = org;
    }
    if (DP.security.twoFA.isEnabled(email)) {
      state.pendingLogin2FA = { org, user: state.user };
      document.getElementById('loginForm').classList.add('hidden');
      document.getElementById('twoFAChallengeStep').classList.remove('hidden');
      document.getElementById('twoFAChallengeCode').value = '';
      document.getElementById('twoFAChallengeCode').focus();
      toast('🔐 Enter your 2FA code','info');
      btn.disabled = false; btn.innerHTML = orig;
      return;
    }
    if (!state.orgs.find(o => o.id === org.id)) state.orgs.push(org);
    DP.LS.set('dp_orgs', state.orgs);
    DP.security.clearAttempts();
    DP.security.lockout.clear(email);
    audit('LOGIN', org.id);
    DP.analytics.event('login', { method:'password' });
    enterApp();
    toast(`Welcome, ${state.user.name}!`, 'success');
  } catch(err) {
    DP.security.recordAttempt();
    let msg = err.message || 'Login failed';
    if (msg.includes('auth/invalid-credential') || msg.includes('auth/wrong-password')) msg = 'Invalid email or password.';
    if (msg.includes('auth/user-not-found')) msg = 'Account not found. Please register.';
    if (msg.includes('auth/too-many-requests')) msg = 'Too many attempts. Try later.';
    toast(msg, 'error');
    DP.errors.capture(err, { context:'login' });
    btn.disabled = false; btn.innerHTML = orig;
  }
}

async function submit2FAChallenge() {
  const code = document.getElementById('twoFAChallengeCode').value.trim();
  const ctx = state.pendingLogin2FA;
  if (!ctx) return;
  const secret = DP.security.twoFA.get(ctx.user.email)?.secret;
  if (!secret) { toast('2FA config error','error'); return; }
  const ok = await DP.totp.verify(secret, code);
  if (!ok) { toast('Invalid 2FA code','error'); return; }
  if (!state.orgs.find(o => o.id === ctx.org.id)) state.orgs.push(ctx.org);
  DP.LS.set('dp_orgs', state.orgs);
  DP.security.clearAttempts(); DP.security.lockout.clear(ctx.user.email);
  state.user = ctx.user; state.org = ctx.org; state.pendingLogin2FA = null;
  audit('LOGIN_2FA', ctx.org.id);
  enterApp();
  toast(`Welcome, ${state.user.name}!`, 'success');
}

async function doRegister(e) {
  e.preventDefault();
  if (!document.getElementById('regTerms').checked) { toast('Please accept Terms & Privacy','error'); return; }
  const orgName = document.getElementById('regOrg').value.trim();
  const name = document.getElementById('regName').value.trim();
  const email = document.getElementById('regEmail').value.trim().toLowerCase();
  const phone = document.getElementById('regPhone').value.trim();
  const accountType = document.getElementById('regType').value;
  const pw = document.getElementById('regPass').value;
  if (!orgName || !name || !email || !phone) { toast('Fill all fields','error'); return; }
  if (!DP.validators.email(email)) { toast('Invalid email format','error'); return; }
  if (!DP.validators.phone(phone)) { toast('Invalid phone format','error'); return; }
  const v = DP.validators.password(pw);
  if (!v.valid) { toast(v.msg,'error'); return; }
  if (state.orgs.some(o => o.email === email)) { toast('Email already registered. Please sign in.','error'); return; }
  const reused = await DP.security.passwordHistory.isReused(email, pw);
  if (reused) { toast('Password was used recently — pick a new one.','error'); return; }
  const btn = e.target.querySelector('button[type="submit"]');
  btn.disabled = true; const orig = btn.innerHTML;
  btn.innerHTML = '<i class="fa-solid fa-spinner spin mr-2"></i>Creating…';
  try {
    let uid = null;
    if (firebaseReady) { const u = await fbRegister(email, pw, name); uid = u.uid; }
    const passwordHash = await DP.bcrypt.hash(pw);
    const code = DP.security.genCode();
    const org = { id:'ORG-'+Date.now().toString(36), uid, name:orgName, email, phone, adminName:name, accountType, plan:'free', status:'active', emailVerified:false, createdAt:new Date().toISOString(), dataCount:0, apiKey:'dp_'+Math.random().toString(36).slice(2,14), passwordHash };
    state.pendingVerify = { org, code, at:Date.now(), password:pw };
    if (firebaseReady) await fbSaveOrg(org.id, org);
    const emailResult = await DP.email.send('verification', email, { name, code });
    document.getElementById('regForm').classList.add('hidden');
    document.getElementById('verifyStep').classList.remove('hidden');
    document.getElementById('verifyEmail').textContent = email;
    document.getElementById('verifyDemoHint').textContent = emailResult.sandbox ? ('⚠ Sandbox: Your code is ' + code) : '';
    const ci = document.getElementById('verifyCode'); ci.value = ''; ci.focus();
    document.getElementById('verifyBtn').disabled = true;
    toast('Verification code sent ✓','info');
    DP.analytics.event('sign_up', { account_type:accountType });
  } catch(err) {
    let msg = err.message || 'Registration failed';
    if (msg.includes('auth/email-already-in-use')) msg = 'Email already registered. Please sign in.';
    if (msg.includes('auth/weak-password')) msg = 'Password too weak.';
    toast(msg, 'error');
    DP.errors.capture(err, { context:'register' });
  }
  btn.disabled = false; btn.innerHTML = orig;
}

