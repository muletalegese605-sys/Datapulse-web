        <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Margin</div><div class="text-amber-400 font-black mono">${k.margin.toFixed(1)}%</div></div>
        <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Low Stock</div><div class="text-rose-400 font-black mono">${k.low}</div></div>
      </div>
      <div class="p-2.5 rounded-lg bg-slate-950/60 border border-sky-500/30 text-[10px] text-slate-300">
        <b class="text-sky-400">Source:</b> ${esc(source)} · <b class="text-sky-400">Time:</b> ${ms}ms
      </div>
      <button onclick="go('reports')" class="w-full py-2.5 bg-gradient-to-r from-emerald-500 to-emerald-600 text-slate-950 font-black text-xs rounded-xl ripple">
        <i class="fa-solid fa-download mr-1"></i>Download Report
      </button>
      <button onclick="showDataLocation()" class="w-full py-2.5 bg-slate-900 border border-emerald-500/40 text-emerald-400 font-bold text-xs rounded-xl ripple">
        <i class="fa-solid fa-database mr-1"></i>Data Storage Location
      </button>
    `;
    showResults('Data Processed Successfully', detail);
  } catch(e){}
  DP.fullAuto.triggerIfEnabled('auto-process:'+source);
  return rows;
}
