async function submitFeedback(e) {
  e.preventDefault();
  const type     = document.getElementById('fbType').value;
  const rating   = parseInt(document.getElementById('fbRating').value) || 0;
  const nps      = DP.feedback.selectedNps;
  const message  = (document.getElementById('fbMessage').value || '').trim();
  const name     = (document.getElementById('fbName').value || '').trim();
  const email    = (document.getElementById('fbEmail').value || '').trim().toLowerCase();
  const publicOk = document.getElementById('fbPublic').checked;
  const gdprOk   = document.getElementById('fbGdpr').checked;
  const fileEl   = document.getElementById('fbFile');
  const hasFile  = document.getElementById('fbAttach').checked && fileEl && fileEl.files[0];

  if (!gdprOk) { toast('Please accept GDPR consent', 'warn'); return; }
  if (!message || message.length < 5) { toast('Please write at least 5 characters', 'warn'); return; }
  if (rating === 0) { toast('Please select a star rating', 'warn'); return; }

  const btn = e.target.querySelector('button[type="submit"]');
  const orig = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<i class="fa-solid fa-spinner spin mr-1"></i>Sending…';

  let attachment = null;
  if (hasFile) { try { attachment = await DP.feedback.fileToBase64(fileEl.files[0]); } catch(err) { toast('Attachment: ' + err.message, 'warn'); } }

  const feedback = {
    id: 'FB-' + Date.now().toString(36).toUpperCase(),
    type, rating, nps, message, name, email,
    public: publicOk,
    sentiment: DP.feedback.sentiment || DP.feedback.analyzeSentiment(message),
    orgId: (typeof state !== 'undefined' && state.org?.id) || 'anonymous',
    orgName: (typeof state !== 'undefined' && state.org?.name) || 'Anonymous',
    userId: (typeof state !== 'undefined' && state.user?.email) || 'anonymous',
    userName: (typeof state !== 'undefined' && state.user?.name) || name || 'Anonymous',
    accountType: (typeof state !== 'undefined' && state.org?.accountType) || '—',
    plan: (typeof state !== 'undefined' && state.org?.plan) || 'free',
    at: nowIso(), timestamp: nowIso(), url: location.href,
    userAgent: navigator.userAgent,
    lang: (typeof DP !== 'undefined' && DP.i18n?.current) || 'en',
    currency: (typeof DP !== 'undefined' && DP.currency?.get?.()) || 'USD',
    theme: (typeof DP !== 'undefined' && DP.theme?.current?.()) || 'dark',
    screen: `${screen.width}x${screen.height}`,
    status: 'new',
    attachment: attachment ? attachment.slice(0, 50000) : null
  };

  const list = DP.LS.get('dp_feedback', []);
  list.unshift(feedback);
  DP.LS.set('dp_feedback', list.slice(0, 500));

  try {
    if (typeof firebaseReady !== 'undefined' && firebaseReady && typeof fbDb !== 'undefined' && fbDb) {
      const doc = { ...feedback }; delete doc.attachment;
      await fbDb.collection('feedback').doc(feedback.id).set(doc, { merge:true });
    }
  } catch(err) { console.warn('Feedback cloud save failed:', err); }

  try {
    if (DP.config.backendDefault) {
      await DP.fetch(DP.config.backendDefault + '/api/feedback', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ ...feedback, attachment: undefined }), _timeout: 6000
      });
    }
  } catch(err) { }

  try { DP.analytics.event('feedback_submitted', { type, rating, nps, sentiment: feedback.sentiment }); } catch(e){}
  try { if (typeof audit === 'function') audit('FEEDBACK_SUBMIT', feedback.id, { type, rating, nps }); } catch(e){}

  closeFeedback();
  try { celebrate(); } catch(e){}
  toast('🙏 Thank you! We read every feedback personally.', 'success');
  setTimeout(() => { toast('💚 Your voice makes DataPulse better!', 'info'); }, 2200);

  if (type === 'praise' && rating === 5 && publicOk) {
    setTimeout(() => {
      if (confirm('🌟 Wow, 5 stars! Can we quote you on our landing page?')) {
        feedback.testimonialApproved = true;
        const l2 = DP.LS.get('dp_feedback', []);
        const i = l2.findIndex(x => x.id === feedback.id);
        if (i >= 0) { l2[i].testimonialApproved = true; DP.LS.set('dp_feedback', l2); }
        toast('🌟 Testimonial approved!', 'success');
      }
    }, 3200);
  }

  btn.disabled = false; btn.innerHTML = orig;
}

