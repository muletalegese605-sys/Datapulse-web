  t(key){
    if (!key) return '';
    const cur = this.dict[this.current];
    if (cur && cur[key] != null && cur[key] !== '') return cur[key];
    const fb = this.dict[this.fallback];
    if (fb && fb[key] != null && fb[key] !== '') return fb[key];
    const parts = String(key).split('.');
    return parts[parts.length-1] || key;
  },
  init(){
    try {
      let saved = 'en';
      try { saved = localStorage.getItem('dp_lang') || 'en'; } catch(e){}
      if (!this.languages.some(l => l.code === saved)) saved = 'en';
      this.current = saved;
      this.renderSelectors();
      const isRTL = ['ar','fa','he','ur'].includes(this.current);
      document.documentElement.setAttribute('lang', this.current);
      document.documentElement.setAttribute('dir', isRTL ? 'rtl' : 'ltr');
    } catch(e){ this.current = 'en'; }
  },
  renderSelectors(){
    try {
      const html = this.languages.map(l => `<option value="${l.code}" ${l.code===this.current?'selected':''}>${l.flag} ${esc(l.name)}</option>`).join('');
      const a = document.getElementById('langSel'); if (a) a.innerHTML = html;
      const b = document.getElementById('langSelL'); if (b) b.innerHTML = html;
    } catch(e){}
  },
  refreshStatic(){
    const t = k => this.t(k);
    const set = (id, val) => { const el = document.getElementById(id); if (el && val !== undefined) el.textContent = val; };
    const setH = (id, val) => { const el = document.getElementById(id); if (el) el.innerHTML = val; };
    set('lHero1', t('landing.hero1'));
    set('lHero2', t('landing.hero2'));
    set('lHero3', t('landing.hero3'));
    set('lHeroDesc', t('hero.desc'));
    set('lForEveryone', t('landing.forEveryone'));
    set('lPricing', t('landing.pricing'));
    set('footerTagline', t('footer.tagline'));
    set('footerRights', t('footer.rights'));
    setH('lLaunch', `<i class="fa-solid fa-rocket mr-2"></i>${esc(t('landing.launch'))}`);
    setH('lViewCaps', `<i class="fa-solid fa-layer-group mr-2 text-emerald-400"></i>${esc(t('landing.viewCaps'))}`);
  },
  set(code){
    try {
      if (!this.languages.some(l => l.code === code)) code = this.fallback;
      this.current = code;
      try { localStorage.setItem('dp_lang', code); } catch(e){}
      const isRTL = ['ar','fa','he','ur'].includes(code);
      document.documentElement.setAttribute('lang', code);
      document.documentElement.setAttribute('dir', isRTL ? 'rtl' : 'ltr');
      this.renderSelectors();
      this.refreshStatic();
      const a = document.getElementById('app');
      if (state.user && a && !a.classList.contains('hidden')) { try { renderNav(); renderDock(); render(); } catch(e){} }
      const l = document.getElementById('landing');
      if (l && !l.classList.contains('hidden')) {
        try { renderLandingSolutions('smb'); renderCapFilter(); renderLandingCaps(state.capFilter); renderLandingOps(); renderLandingPlans(); } catch(e){}
      }
      if (state.aiChat.length && state.user) {
        state.aiChat = [{ role:'ai', text: this.t('ai.title') + ' — ' + this.t('ai.subtitle') }];
        if (state.tab === 'ai') { try { drawAiMessages(); } catch(e){} }
      }
      toast(this.t('toast.langChanged'), 'success');
    } catch(e){ console.warn('Lang switch:', e); }
  }
};
