  async run(source='auto') {
    if (this.running) return;
    if (!state.records.length) return;
    this.running = true;

    const overlay  = document.getElementById('fullAutoOverlay');
    const log      = document.getElementById('fullAutoLog');
    const bar      = document.getElementById('fullAutoBar');
    const pct      = document.getElementById('fullAutoPct');
    const status   = document.getElementById('fullAutoStatus');
    const phase    = document.getElementById('fullAutoPhase');

    if (overlay) overlay.classList.add('on');
    if (log) log.innerHTML = '';

    const logLine = (msg, icon='✓') => {
      if (!log) return;
      const line = document.createElement('div');
      line.className = 'flex items-center gap-2 py-0.5';
      line.innerHTML = `<span style="color:#10b981;min-width:12px">${icon}</span><span style="color:#cbd5e1">${esc(msg)}</span>`;
      log.appendChild(line);
      log.scrollTop = log.scrollHeight;
    };

    const total = this.opSteps.length + this.capSteps.length;
    let done = 0;
    const tick = () => {
      done++;
      const p = Math.round(done/total*100);
      if (bar) bar.style.width = p + '%';
      if (pct) pct.textContent = p + '%';
    };

    this._results = {};
    const t0 = performance.now();

    try {
      if (status) status.textContent = '⚙️ Phase 1/2 — Running 17 Data Ops';
      if (phase)  phase.textContent  = 'Phase 1/2 · Data Ops';
      logLine(`Starting 17 Data Ops (${this.opSteps.length} steps)…`, '⚙️');
      for (const step of this.opSteps) {
        try {
          await step.run();
          logLine(step.name, '✓');
        } catch(e) {
          logLine(step.name + ' — ' + (e.message||'skipped'), '⚠');
        }
        tick();
        await new Promise(r => setTimeout(r, 45));
      }

      if (status) status.textContent = '⚡ Phase 2/2 — Running 40 Capabilities';
      if (phase)  phase.textContent  = 'Phase 2/2 · Capabilities';
      logLine(`Starting 40 Capabilities (${this.capSteps.length} modules)…`, '⚡');
      for (const step of this.capSteps) {
        try {
          await step.run();
          logLine(step.name, '✓');
        } catch(e) {
          logLine(step.name + ' — ' + (e.message||'skipped'), '⚠');
        }
        tick();
        await new Promise(r => setTimeout(r, 45));
      }

      await saveRecords();

      const ms = Math.round(performance.now() - t0);
      this.stats.runs++;
      this.stats.lastRun = new Date().toISOString();
      this.stats.capsRun = this.capSteps.length;
      this.stats.opsRun  = this.opSteps.length;

      logLine(`✅ Complete — ${this.opSteps.length} ops + ${this.capSteps.length} caps in ${ms}ms`, '🎉');
      if (status) status.textContent = '✅ Full automation complete';
      if (phase)  phase.textContent  = `Total ${total} actions · ${ms}ms`;

      audit('FULL_AUTO_PIPELINE', source, {
        ops: this.opSteps.length,
        caps: this.capSteps.length,
        ms, results: this._results
      });
      DP.analytics.event('full_auto_pipeline', {
        source, ops:this.opSteps.length, caps:this.capSteps.length, ms
      });

      await new Promise(r => setTimeout(r, 1000));
    } catch(err) {
      logLine('Pipeline error: ' + (err.message||'unknown'), '✗');
      DP.errors.capture(err, { context:'fullAuto' });
      await new Promise(r => setTimeout(r, 800));
    } finally {
      if (overlay) overlay.classList.remove('on');
      this.running = false;
      toast(`🚀 Full Automation: ${this.opSteps.length} ops + ${this.capSteps.length} caps ✓`, 'success');
      // ★ Show results panel after automation
      try {
        const r = this._results;
        const k = r.kpi || kpis();
        const detail = `
          <div class="grid grid-cols-2 gap-2 text-[11px]">
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Records</div><div class="text-emerald-400 font-black mono">${k.count.toLocaleString()}</div></div>
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Revenue</div><div class="text-emerald-400 font-black mono break-all">${DP.currency.format(k.sales/57.5)}</div></div>
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Margin</div><div class="text-amber-400 font-black mono">${k.margin.toFixed(1)}%</div></div>
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Low Stock</div><div class="text-rose-400 font-black mono">${k.low}</div></div>
          </div>
          <div class="p-2.5 rounded-lg bg-slate-950/60 border border-emerald-500/30 text-[10px] text-slate-300">
            <b class="text-emerald-400">17 Ops</b> + <b class="text-emerald-400">40 Caps</b> hojjetan ✓
