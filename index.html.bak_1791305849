   ERROR MONITORING
   ============================================================ */
DP.errors = {
  list: [],
  init() {
    if (this._wired) return;
    this._wired = true;
    const prefs = DP.gdpr.get();
    if (prefs && !prefs.errors) return;
    window.addEventListener('error', (e) => {
      if ((e.message||'').includes('NetworkError') || (e.message||'').includes('Failed to fetch')) return;
      this.capture(e.error || e.message, { type:'error', file:e.filename, line:e.lineno });
    });
    window.addEventListener('unhandledrejection', (e) => {
      const r = String(e.reason?.message || e.reason || '');
