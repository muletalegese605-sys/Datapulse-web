(function patchAIForFeedback() {
  if (!DP.ai || !DP.ai.localAnswer) return;
  const original = DP.ai.localAnswer.bind(DP.ai);
  DP.ai.localAnswer = function(q) {
    q = String(q || '').toLowerCase();
    if (/feedback|comment|suggestion|complaint|testimonial|frankii|yaada|komii/.test(q)) {
      const list = DP.LS.get('dp_feedback', []);
      if (!list.length) return `💬 No feedback submitted yet. Click the yellow 💬 button (bottom-right) or press Alt+F.`;
      const avg = (list.reduce((s, f) => s + (f.rating||0), 0) / list.length).toFixed(1);
      const npsList = list.filter(f => f.nps != null);
      const promoters = npsList.filter(f => f.nps >= 9).length;
      const detractors = npsList.filter(f => f.nps <= 6).length;
      const nps = npsList.length ? Math.round((promoters / npsList.length - detractors / npsList.length) * 100) : null;
      const byType = { bug:0, idea:0, feature:0, praise:0, other:0 };
      list.forEach(f => { byType[f.type] = (byType[f.type]||0) + 1; });
      return `💬 Feedback: ${list.length} total · ⭐ ${avg}/5 · NPS ${nps != null ? nps : '—'}\nBugs: ${byType.bug} · Ideas: ${byType.idea} · Praise: ${byType.praise}`;
    }
    return original(q);
  };
})();

