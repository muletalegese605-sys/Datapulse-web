DP.feedback = {
  selectedRating: 0,
  selectedNps: null,
  sentiment: '',
  analyzeSentiment(text) {
    const t = text.toLowerCase();
    const pos = ['good','great','excellent','love','awesome','perfect','amazing','best','helpful','easy','fast','beautiful','wonderful','thanks','thank','super','nice','happy','bareedaa','salphaa','guddaa','galatoomi','akkam','miidhagaa'];
    const neg = ['bad','terrible','slow','bug','broken','crash','fail','error','hate','awful','worst','confusing','hard','difficult','missing','problem','issue','hamaa','ulfaataa','rakkoo','badhaadhaa','hin'];
    const positive = pos.filter(w => t.includes(w)).length;
    const negative = neg.filter(w => t.includes(w)).length;
    if (positive > negative) return 'positive';
    if (negative > positive) return 'negative';
    return 'neutral';
  },
  async fileToBase64(file) {
    return new Promise((res, rej) => {
      if (file.size > 2 * 1024 * 1024) { rej(new Error('Image too large (max 2MB)')); return; }
      const r = new FileReader();
      r.onload = () => res(r.result);
      r.onerror = () => rej(new Error('Read failed'));
      r.readAsDataURL(file);
    });
  }
};

