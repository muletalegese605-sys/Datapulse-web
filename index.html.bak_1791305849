DP.ai = {
  mode:'local', endpoint:'', apiKey:'',
  _enc(s){ try { return btoa(String.fromCharCode(...new TextEncoder().encode(s))); } catch(e){ return ''; } },
  _dec(s){ try { return new TextDecoder().decode(Uint8Array.from(atob(s), c => c.charCodeAt(0))); } catch(e){ return ''; } },
  init(){ this.mode = localStorage.getItem('dp_ai_mode') || 'local'; this.endpoint = localStorage.getItem('dp_ai_endpoint') || ''; const enc = localStorage.getItem('dp_ai_key_enc') || ''; this.apiKey = enc ? this._dec(enc) : ''; },
  async ask(q) {
    q = String(q||'').toLowerCase().trim(); if (!q) return '';
    if (this.mode === 'remote' && this.endpoint) {
      try {
        const res = await DP.fetch(this.endpoint, { method:'POST', headers:{ 'Content-Type':'application/json', ...(this.apiKey ? {'Authorization':'Bearer '+this.apiKey} : {}) }, body: JSON.stringify({ message:q, lang:DP.i18n.current }), _timeout: 15000 });
        if (res.ok) { const d = await res.json(); const r = d.reply || d.message || (d.choices && d.choices[0] && d.choices[0].message && d.choices[0].message.content); if (r) return r; }
      } catch(e){}
    }
    return this.localAnswer(q);
  },
  localAnswer(q) {
    const k = kpis();
    if (state.records.length === 0) return `👋 Welcome to DataPulse!\n\nYou haven't uploaded any data yet.\n\nGo to **Ingest** tab to:\n• Upload CSV / Excel / JSON / XML\n• Connect Google Sheets\n• Sync from REST API\n• Paste data\n• Add rows manually\n\nOnce data arrives, all 40 capabilities + 17 data ops analyze it automatically.`;
    if (/automation|full|special/.test(q)) return `🚀 Full Automation Special Mode:\n\nToggles in Auto Pipeline tab → runs all 17 Data Ops + 40 Capabilities in coordinated sequence.\n\nRuns: ${DP.fullAuto.stats.runs} times\nLast: ${DP.fullAuto.stats.lastRun || 'Never'}`;
    if (/storage|location|where is data/.test(q)) return `📂 Data Storage Location:\n\n• Browser LocalStorage: dp_records_${state.org?.id||'...'}\n• Firebase Firestore: datasets/${state.org?.id||'...'}\n• Backend API: ${DP.config.backendDefault}\n\nClick "View Data Map" in the results panel for full details.`;
    if (/help|capabilities|ops/.test(q)) return `🤖 I can help with: analyze data, low stock, profit margins, forecasts, data sources, pricing, privacy, 17 Data Ops, 40 Capabilities, Full Automation.`;
    if (/low|stock/.test(q)) { const low = state.records.filter(r => +r.stock <= 10).slice(0,8); return low.length ? `⚠️ ${low.length} low stock: ${low.map(r=>`${r.name} (${r.stock})`).join(', ')}` : `✓ No low stock items.`; }
    if (/profit|margin/.test(q)) return `💰 Net Profit: ${DP.currency.format(k.profit/57.5)} · Margin: ${k.margin.toFixed(2)}%`;
    if (/forecast|predict/.test(q)) return `📈 Forecast (+30d): ${DP.currency.format(k.sales*1.12/57.5)} (+12%)`;
    if (/revenue|sales/.test(q)) return `📊 Gross Sales: ${DP.currency.format(k.sales/57.5)} · Records: ${k.count}`;
    if (/cost|expense/.test(q)) return `💸 Expenses: ${DP.currency.format(k.cost/57.5)}`;
    if (/currency/.test(q)) { const cur = DP.CURRENCIES[DP.currency.get()]; return `💱 Current: ${cur.flag} ${DP.currency.get()} (${cur.name})`; }
    if (/privacy|secure/.test(q)) return `🔒 AES-256 encryption. 2FA available. bcrypt hashing. GDPR compliant.`;
    if (/price|payment|plan/.test(q)) return `💳 Free · Starter $29 · Pro $99 · Enterprise $499. 14-day free trial.`;
    if (/source|import|ingest/.test(q)) return `📥 12 sources: CSV, TSV, XLSX, XLS, JSON, JSONL, XML, Google Sheets, API, Webhook, IoT, Manual.`;
    if (/report|export/.test(q)) return `📄 8 formats: PDF, XLSX, CSV, JSON, DOCX, HTML, MD, XML.`;
    if (/hi|hello|hey|akkam/.test(q)) return `👋 Hello! Ask me about your data, KPIs, capabilities, or full automation.`;
    return `🤖 Overview:\n\n📊 ${k.count} records · ${DP.currency.format(k.sales/57.5)} · Margin ${k.margin.toFixed(1)}% · Low stock: ${k.low}\n\nFull Automation: ${DP.fullAuto.enabled?'ON':'OFF'} (${DP.fullAuto.stats.runs} runs)`;
  }
};

