DP.bcrypt = {
  loaded: false,
  async load() {
    if (this.loaded) return true;
    try { await DP.loadScript('https://cdn.jsdelivr.net/npm/bcryptjs@2.4.3/dist/bcrypt.min.js'); this.loaded = typeof window.bcrypt !== 'undefined'; return this.loaded; }
    catch(e){ return false; }
  },
  async hash(pw) {
    if (await this.load()) return await window.bcrypt.hash(pw, 10);
    const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pw + '_dp_salt_v2'));
    return 'sha256$' + Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
  },
  async verify(pw, hash) {
    if (hash.startsWith('sha256$')) {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(pw + '_dp_salt_v2'));
      const h = 'sha256$' + Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2,'0')).join('');
      return h === hash;
    }
    if (await this.load()) return await window.bcrypt.compare(pw, hash);
    return false;
  }
};

DP.totp = {
  generateSecret() { const c = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'; let s = ''; for (let i = 0; i < 16; i++) s += c[Math.floor(Math.random()*c.length)]; return s; },
  async _code(secret, w) { const input = `${secret}:${w}`; const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(input)); const arr = new Uint8Array(buf); const num = ((arr[0]<<24)|(arr[1]<<16)|(arr[2]<<8)|arr[3]) >>> 0; return String(num % 1000000).padStart(6,'0'); },
  async generateCode(secret) { return await this._code(secret, Math.floor(Date.now()/30000)); },
  async verify(secret, code) { const w = Math.floor(Date.now()/30000); const e = await this._code(secret, w); const p = await this._code(secret, w-1); return code === e || code === p; }
};

