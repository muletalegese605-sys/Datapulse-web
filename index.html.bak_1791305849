/* ============================================================
   ANALYTICS v8.0 — GA4 + Offline Queue + 15 Events
   ============================================================ */
DP.analytics = {
  ready: false,
  queueKey: 'dp_analytics_queue',
  sessionKey: 'dp_analytics_session',
  ready_ga: false,

  init() {
    if (this.ready) return;
    this.ready = true;
    const prefs = DP.gdpr.get();
    if (prefs && !prefs.analytics) { console.info('📊 Analytics: disabled by consent'); return; }
    this.ensureSession();
    if (ANALYTICS_ID && ANALYTICS_ID.startsWith('G-')) {
      DP.loadScript('https://www.googletagmanager.com/gtag/js?id=' + ANALYTICS_ID)
        .then(() => {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', ANALYTICS_ID, { anonymize_ip: true, send_page_view: true, transport_type: 'beacon' });
          this.ready_ga = true;
          console.log('✅ GA4 ready');
          this.flushQueue();
        })
        .catch(() => console.warn('GA4 load failed'));
    } else {
      console.info('ℹ️ Analytics: GA4 ID not set');
    }
    setInterval(() => this.flushQueue(), 30000);
    window.addEventListener('online', () => this.flushQueue());
  },

  ensureSession() {
    let s = DP.LS.get(this.sessionKey, null);
    const now = Date.now();
    if (!s || (now - s.startedAt) > 1800000) {
      s = { id: 'S-' + now.toString(36) + '-' + Math.random().toString(36).slice(2,7), startedAt: now, pageviews: 0 };
      DP.LS.set(this.sessionKey, s);
    }
    return s;
  },
  getSession() { return this.ensureSession(); },

  event(name, params) {
    if (!name) return;
    params = params || {};
    const payload = Object.assign({}, params, {
      session_id: this.getSession().id,
      app_version: (typeof APP_VERSION !== 'undefined') ? APP_VERSION : '8.0.0',
      app_env: (typeof APP_ENV !== 'undefined') ? APP_ENV : 'production',
      lang: DP.i18n.current,
      currency: DP.currency.get(),
      org_id: (typeof state !== 'undefined' && state.org) ? state.org.id : null,
      plan: (typeof state !== 'undefined' && state.org) ? state.org.plan : null
    });
    if (this.ready_ga && typeof window.gtag === 'function') {
      try { window.gtag('event', name, payload); } catch(e){}
    } else {
      this.enqueue({ name, params: payload, at: new Date().toISOString() });
    }
    if (window.location.search.includes('analytics_debug=1')) console.log('📊 Event:', name, payload);
  },

  enqueue(item) {
    const q = DP.LS.get(this.queueKey, []);
    q.push(item);
    DP.LS.set(this.queueKey, q.slice(-200));
  },
  flushQueue() {
    if (!this.ready_ga) return;
    const q = DP.LS.get(this.queueKey, []);
    if (!q.length) return;
    q.forEach(item => { try { window.gtag('event', item.name, item.params); } catch(e){} });
    DP.LS.set(this.queueKey, []);
  },

  trackSignUp(t) { this.event('sign_up', { account_type: t }); },
  trackLogin(r) { this.event('login', { role: r }); },
  trackFileUpload(t, mb, rows) { this.event('file_upload', { file_type: t, size_mb: mb, rows_count: rows }); },
  trackCapabilityRun(id, name) { this.event('capability_run', { capability_id: id, capability_name: name }); },
  trackOpRun(id, name) { this.event('op_run', { op_id: id, op_name: name }); },
  trackReportDownload(fmt) { this.event('report_download', { format: fmt }); },
  trackLanguageChange(from, to) { this.event('language_change', { from, to }); },
  trackCurrencyChange(from, to) { this.event('currency_change', { from, to }); },
  trackFullAuto(orgId, on) { this.event('full_auto_toggle', { org_id: orgId, enabled: !!on }); },
  trackAiQuery(len) { this.event('ai_query', { query_length: len }); },
  trackFeedbackSubmit(t, r, n, s) { this.event('feedback_submit', { type: t, rating: r, nps: n, sentiment: s }); }
};

