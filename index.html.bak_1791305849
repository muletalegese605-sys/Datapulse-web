async function autoProcessData(raw, source='unknown', progressCb) {
  if (!requireAccess()) return [];
  if (!Array.isArray(raw) || !raw.length) { toast('No valid data found','warn'); return []; }
  const t0 = performance.now();
  const isBig = raw.length > DP.config.largeDataThreshold;
  if (isBig) DP.bigData.show(`Processing ${raw.length.toLocaleString()} rows`, 'Large dataset detected');
  const wrapProgress = (done, total) => { if (isBig) DP.bigData.update(done, total); if (progressCb) progressCb(done, total); };
  let rows;
  try { rows = await DP.data.chunkProcess(raw, wrapProgress); }
  finally { if (isBig) setTimeout(() => DP.bigData.hide(), 400); }
  state.records = rows;
  state.org.dataCount = (state.org.dataCount||0) + rows.length;
  await saveRecords();
  const k = kpis();
  if (k.low > 0) toast(`⚠️ ${k.low} items low on stock!`, 'warn');
  const ms = Math.round(performance.now() - t0);
  audit('AUTO_PROCESS', source, { rows:rows.length, ms });
  DP.analytics.event('data_processed', { rows:rows.length, ms, source });
  toast(`✓ Processed ${rows.length.toLocaleString()} rows · ${ms}ms`, 'success');
  // ★ Auto-show results panel
  try {
    const detail = `
      <div class="grid grid-cols-2 gap-2 text-[11px]">
