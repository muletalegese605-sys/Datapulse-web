DP.session = {
  timeoutMs: 30 * 60 * 1000,
  timer: null, tickInterval: null, lastActivity: Date.now(), onExpire: null, handlers: [],
  start(onExpire) {
    this.onExpire = onExpire; this.lastActivity = Date.now();
    const events = ['click','keydown','mousemove','scroll','touchstart'];
    this.handlers.forEach(h => document.removeEventListener(h.ev, h.fn));
    this.handlers = events.map(ev => { const fn = () => this.reset(); document.addEventListener(ev, fn, { passive:true }); return { ev, fn }; });
    this.reset();
    this.tickInterval = setInterval(() => this.tick(), 1000);
    const b = document.getElementById('sessionBadge'); if (b) b.classList.remove('hidden');
  },
  reset() { this.lastActivity = Date.now(); if (this.timer) clearTimeout(this.timer); this.timer = setTimeout(() => this.expire(), this.timeoutMs); },
  tick() { const el = document.getElementById('sessionTimer'); if (!el) return; const r = Math.max(0, this.timeoutMs - (Date.now()-this.lastActivity)); const m = Math.floor(r/60000); const s = Math.floor((r%60000)/1000); el.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`; if (r < 5*60000) el.classList.add('text-rose-400'); else el.classList.remove('text-rose-400'); },
  expire() { const b = document.getElementById('sessionBadge'); if (b) b.classList.add('hidden'); if (this.tickInterval) { clearInterval(this.tickInterval); this.tickInterval = null; } if (this.onExpire) this.onExpire(); },
  stop() { if (this.timer) { clearTimeout(this.timer); this.timer = null; } if (this.tickInterval) { clearInterval(this.tickInterval); this.tickInterval = null; } this.handlers.forEach(h => document.removeEventListener(h.ev, h.fn)); this.handlers = []; const b = document.getElementById('sessionBadge'); if (b) b.classList.add('hidden'); }
};

