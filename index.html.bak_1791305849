/* Toggle body.auth-active when auth screen is visible */
(function(){
  function updateAuthClass(){
    var authVisible = document.getElementById('authScreen') && !document.getElementById('authScreen').classList.contains('hidden');
    var landingVisible = document.getElementById('landing') && !document.getElementById('landing').classList.contains('hidden');
    if (authVisible || landingVisible) document.body.classList.add('auth-active');
    else document.body.classList.remove('auth-active');
  }
  document.addEventListener('DOMContentLoaded', function(){
    updateAuthClass();
    // Watch for class changes on authScreen and landing
    var obs = new MutationObserver(updateAuthClass);
    ['authScreen','landing','app'].forEach(function(id){
      var el = document.getElementById(id);
      if (el) obs.observe(el, { attributes:true, attributeFilter:['class'] });
    });
  });
  window.dpUpdateAuthClass = updateAuthClass;
})();

