DP.fetch = async (url, opts={}) => {
  const attempts = opts._retries ?? 0;
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), opts._timeout || DP.config.requestTimeout);
  try { const { _timeout, _retries, ...rest } = opts; const res = await fetch(url, { ...rest, signal: ctrl.signal }); clearTimeout(t); return res; }
  catch(err) {
    clearTimeout(t);
    if (attempts < DP.config.retryAttempts && err.name !== 'AbortError') { await new Promise(r => setTimeout(r, DP.config.retryDelayMs * (attempts+1))); return DP.fetch(url, { ...opts, _retries: attempts+1 }); }
    throw err;
  }
};

/* ---------- DATA PROCESSOR ---------- */
DP.data = {
  normalizeRows(raw) {
    return raw.map((r,i) => {
      if (!r || typeof r !== 'object') return { id:`AUTO-${i+1}`, name:`Item ${i+1}`, category:'General', price:100, cost:70, stock:10, unit:'Units' };
      const keys = Object.keys(r);
      const nk = keys.find(k => /name|item|title|product/i.test(k)) || keys[0];
      const ck = keys.find(k => /cat|type|group/i.test(k));
      const pk = keys.find(k => /price|sell|rate|amount/i.test(k));
      const co = keys.find(k => /cost|expense|cogs/i.test(k));
      const sk = keys.find(k => /stock|qty|quantity|count/i.test(k));
      const uk = keys.find(k => /unit|measure/i.test(k));
      return {
        id: String(r.id || r.ID || `AUTO-${String(i+1).padStart(4,'0')}`).slice(0, 40),
        name: String(r[nk] || `Item ${i+1}`).slice(0, 120),
        category: ck ? String(r[ck]).slice(0,60) : 'General',
        price: parseFloat(String(pk?r[pk]:0).replace(/[^0-9.-]/g,'')) || 100,
        cost: parseFloat(String(co?r[co]:0).replace(/[^0-9.-]/g,'')) || 70,
        stock: parseInt(String(sk?r[sk]:0).replace(/[^0-9-]/g,'')) || 10,
        unit: uk ? String(r[uk]).slice(0,20) : 'Units'
      };
    });
  },
  autoClean(rows) {
    return rows.map(r => {
      const c = { ...r };
      if (!c.name || !String(c.name).trim()) c.name = 'Item-'+c.id;
      if (!c.category || !String(c.category).trim()) c.category = 'General';
      if (isNaN(+c.price) || +c.price <= 0) c.price = 100;
      if (isNaN(+c.cost) || +c.cost <= 0) c.cost = Math.round(+c.price*0.7);
      if (isNaN(+c.stock) || +c.stock < 0) c.stock = 5;
      return c;
    });
  },
  parseCSVText(text) {
    const lines = text.split(/\r?\n/).filter(l => l.trim());
    if (lines.length < 2) throw new Error('Empty file');
    const sep = text.includes('\t') ? '\t' : ',';
    const headers = lines[0].split(sep).map(h => h.trim().replace(/^["']|["']$/g,''));
    return lines.slice(1).map(l => { const cols = l.split(sep).map(c => c.trim().replace(/^["']|["']$/g,'')); const o = {}; headers.forEach((h,i) => o[h] = cols[i] ?? ''); return o; });
  },
  parseJSONLines(text) { return text.split(/\r?\n/).filter(l => l.trim()).map(l => JSON.parse(l)); },
  parseXML(text) { const xml = new DOMParser().parseFromString(text, 'text/xml'); return Array.from(xml.querySelectorAll('item, row, record, entry')).map(item => { const o = {}; Array.from(item.children).forEach(c => { o[c.tagName] = c.textContent; }); return o; }); },
  async chunkProcess(rows, onProgress) {
    const out = []; const total = rows.length; const size = DP.config.chunkSize;
    for (let i=0; i<total; i+=size) {
      const slice = rows.slice(i, i+size);
      const normalized = DP.data.normalizeRows(slice);
      const cleaned = DP.data.autoClean(normalized);
      out.push(...cleaned.filter(r => r.name && String(r.name).trim()));
      if (onProgress) onProgress(Math.min(i+size, total), total);
      await new Promise(r => setTimeout(r, 0));
    }
    return out;
  },
  exportToCSV(data, filename='datapulse-report.csv') {
    if (!data.length) throw new Error('No data');
    const h = Object.keys(data[0]);
    const rows = data.map(r => h.map(k => `"${String(r[k]??'').replace(/"/g,'""')}"`).join(','));
    const csv = '\uFEFF' + [h.join(','), ...rows].join('\n');
    this._download(new Blob([csv], { type:'text/csv;charset=utf-8' }), filename);
  },
