function manage2FA() {
  const email = state.user.email;
  if (DP.security.twoFA.isEnabled(email)) {
    if (confirm('Disable 2FA? This reduces security.')) { DP.security.twoFA.disable(email); toast('2FA disabled','warn'); render(); }
  } else {
    const secret = DP.totp.generateSecret();
    const code = prompt(`Your 2FA secret:\n\n${secret}\n\nAdd to Google Authenticator, then enter 6-digit code:`);
    if (code) {
      DP.totp.verify(secret, code.trim()).then(ok => { if (ok) { DP.security.twoFA.enable(email, secret); toast('🔐 2FA enabled ✓','success'); render(); } else { toast('Invalid code','error'); } });
    }
  }
}

