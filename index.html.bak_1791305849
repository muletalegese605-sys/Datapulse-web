async function ingestLink(url) { url = url || document.getElementById('linkInput')?.value; if (!url) { toast('URL required','warn'); return; } if (!requireAccess()) return; try { let fetchUrl = url; if (url.includes('docs.google.com/spreadsheets')) { const m = url.match(/\/d\/([^\/]+)/); const gid = url.match(/gid=([0-9]+)/); if (m) { fetchUrl = `https://docs.google.com/spreadsheets/d/${m[1]}/export?format=csv`; if (gid) fetchUrl += `&gid=${gid[1]}`; } } const res = await DP.fetch(fetchUrl); const ct = res.headers.get('content-type') || ''; let raw; if (ct.includes('json') || fetchUrl.endsWith('.json')) { const d = await res.json(); raw = Array.isArray(d) ? d : (d.items||d.data||[]); } else if (ct.includes('xml') || fetchUrl.endsWith('.xml')) { raw = DP.data.parseXML(await res.text()); } else { raw = DP.data.parseCSVText(await res.text()); } await autoProcessData(raw, 'link'); render(); } catch(e) { toast('Link failed: ' + e.message, 'error'); DP.errors.capture(e, { context:'ingestLink' }); } }
async function ingestApi() { if (!requireAccess()) return; const url = document.getElementById('apiInput')?.value; const token = document.getElementById('apiToken')?.value; if (!url) { toast('URL required','warn'); return; } try { const headers = token ? { 'Authorization':'Bearer '+token } : {}; const res = await DP.fetch(url, { headers }); const data = await res.json(); const items = Array.isArray(data) ? data : (data.items||data.data||data.results||[]); await autoProcessData(items, 'api'); render(); } catch(e) { toast('API failed: ' + e.message, 'error'); DP.errors.capture(e, { context:'ingestApi' }); } }
async function ingestPaste() { if (!requireAccess()) return; const txt = (document.getElementById('pasteArea')?.value || '').trim(); if (!txt) { toast('Nothing to paste','warn'); return; } try { let rows; if (txt.startsWith('[') || txt.startsWith('{')) rows = JSON.parse(txt); else if (txt.startsWith('<?xml') || txt.startsWith('<')) rows = DP.data.parseXML(txt); else if (txt.split('\n').every(l => !l.trim() || l.trim().startsWith('{'))) rows = DP.data.parseJSONLines(txt); else rows = DP.data.parseCSVText(txt); if (!Array.isArray(rows)) rows = rows.items || rows.data || []; await autoProcessData(rows, 'paste'); render(); document.getElementById('pasteArea').value = ''; } catch(e) { toast('Import failed: ' + e.message, 'error'); } }

