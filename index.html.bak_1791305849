  idx:0, active:false,
  start(force){ if (!force && DP.LS.get('dp_tour_done', false)) return; if (state.tab !== 'dashboard') go('dashboard'); setTimeout(() => { this.active = true; this.idx = 0; const ov = document.getElementById('tourOverlay'); if (!ov) return; ov.classList.add('on'); ov.setAttribute('aria-hidden','false'); this.show(); }, 500); },
