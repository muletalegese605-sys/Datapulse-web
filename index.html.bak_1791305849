let sigCtx = null, sigDrawing = false;
function openSignatureModal() { if (!state.records.length) { toast('No data to sign','warn'); return; } const modal = document.getElementById('signatureModal'); modal.classList.add('on'); const canvas = document.getElementById('signatureCanvas'); canvas.width = Math.min(600, window.innerWidth - 64); canvas.height = 180; sigCtx = canvas.getContext('2d'); sigCtx.fillStyle = '#0b0f19'; sigCtx.fillRect(0,0,canvas.width,canvas.height); sigCtx.strokeStyle = '#10b981'; sigCtx.lineWidth = 2.5; sigCtx.lineCap = 'round'; sigCtx.lineJoin = 'round'; sigDrawing = false; canvas.onpointerdown = (e) => { sigDrawing = true; sigCtx.beginPath(); const r = canvas.getBoundingClientRect(); sigCtx.moveTo(e.clientX - r.left, e.clientY - r.top); }; canvas.onpointermove = (e) => { if (!sigDrawing) return; const r = canvas.getBoundingClientRect(); sigCtx.lineTo(e.clientX - r.left, e.clientY - r.top); sigCtx.stroke(); }; canvas.onpointerup = () => { sigDrawing = false; }; canvas.onpointerleave = () => { sigDrawing = false; }; }
function closeSignatureModal() { document.getElementById('signatureModal').classList.remove('on'); }
function clearSignature() { const canvas = document.getElementById('signatureCanvas'); if (!sigCtx) return; sigCtx.fillStyle = '#0b0f19'; sigCtx.fillRect(0,0,canvas.width,canvas.height); }
