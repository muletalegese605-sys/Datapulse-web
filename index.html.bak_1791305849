async function handleCsv(event) {
  const file = event.target.files[0]; if (!file) return;
  if (!requireAccess()) { event.target.value=''; return; }
  const sizeMB = file.size / (1024*1024);
  if (sizeMB > DP.config.maxFileMB) { toast(`File too large. Max ${DP.config.maxFileMB}MB`,'error'); event.target.value=''; return; }
  const p1 = document.getElementById('importProgress'); const bar1 = document.getElementById('importBar'); const st1 = document.getElementById('importStatus');
  if (p1) p1.classList.remove('hidden');
  const onProgress = (done, total) => { const pct = Math.round(done/total*100); if (bar1) bar1.style.width = pct+'%'; if (st1) st1.textContent = `Processing ${done.toLocaleString()}/${total.toLocaleString()} (${pct}%)`; };
  try {
    let rows = [];
    const ext = file.name.split('.').pop().toLowerCase();
    if (['xlsx','xls'].includes(ext)) { const XLSX = await DP.loadXLSX(); const buf = await file.arrayBuffer(); const wb = XLSX.read(new Uint8Array(buf), { type:'array' }); rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval:'' }); }
    else if (ext === 'json') { const d = JSON.parse(await file.text()); rows = Array.isArray(d) ? d : (d.items||d.data||[]); }
    else if (ext === 'jsonl') rows = DP.data.parseJSONLines(await file.text());
    else if (ext === 'xml') rows = DP.data.parseXML(await file.text());
    else rows = DP.data.parseCSVText(await file.text());
    await autoProcessData(rows, 'file:'+file.name, onProgress);
    render();
  } catch(err) { toast('Import failed: ' + err.message,'error'); DP.errors.capture(err, { context:'handleCsv', file:file.name }); }
  finally { event.target.value=''; setTimeout(() => { if (p1) p1.classList.add('hidden'); if (bar1) bar1.style.width='0%'; }, 900); }
}

async function checkBackendHealth(verbose) {
  if (state.backendChecking) return;
  state.backendChecking = true;
  const url = (document.getElementById('backendUrl')?.value || DP.config.backendDefault).trim().replace(/\/$/,'');
  const dot = document.getElementById('backendDot'); const st = document.getElementById('backendStatus'); const icon = document.getElementById('syncIcon');
  if (icon) icon.classList.add('fa-spin');
  if (dot) dot.className = 'w-2 h-2 rounded-full bg-amber-400 pulse-dot';
  if (st) st.textContent = '(checking…)';
  let connected = false;
  const endpoints = ['/health','/health_check','/api/health','/ping','/'];
  const t0 = performance.now();
  for (const ep of endpoints) {
    if (performance.now() - t0 > 8000) break;
    try {
      const ctrl = new AbortController();
      const to = setTimeout(() => ctrl.abort(), DP.config.healthTimeout);
      const res = await fetch(url + ep, { method:'GET', mode:'cors', credentials:'omit', signal: ctrl.signal });
      clearTimeout(to);
      if (res.ok || res.status === 204 || res.status === 401 || res.status === 403) { connected = true; break; }
    } catch(e){ /* silent */ }
  }
  state.backendOnline = connected;
  if (connected) { if (dot) dot.className='w-2 h-2 rounded-full bg-emerald-400 pulse-dot'; if (st) st.textContent='CONNECTED'; if (verbose) toast('Backend connected ✓','success'); }
  else { if (dot) dot.className='w-2 h-2 rounded-full bg-rose-400'; if (st) st.textContent='OFFLINE'; if (verbose) toast('Backend offline — running in local mode (all data saved)','info'); }
  if (icon) icon.classList.remove('fa-spin');
  state.backendChecking = false;
  return connected;
}
