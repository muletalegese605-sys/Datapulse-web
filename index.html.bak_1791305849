async function drawDashChart() { 
  const ctx = document.getElementById('dashChart'); 
  if (!ctx) return; 
  try { 
    const ChartLib = await DP.loadChart(); 
    if (!ChartLib) return; 
    if (!document.getElementById('dashChart')) return; 
    ChartLib.defaults.color = DP.theme.current()==='dark' ? '#94a3b8' : '#475569'; 
    state.charts.dash = new ChartLib(ctx, { type:'bar', data:{ labels: state.records.map(r => String(r.name).slice(0,14)), datasets:[{ label:'Revenue', data: state.records.map(r => (+r.price||0)*(+r.stock||0)), backgroundColor:'rgba(16,185,129,0.7)', borderRadius:5 }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false} } } }); 
  } catch(e){ console.warn('drawDashChart error:', e); } 
}
async function drawDashExtras(){ 
  try {
    if (document.getElementById('pieChart')) state.charts.pie = await DP.charts.pie('pieChart'); 
    if (document.getElementById('lineChart')) state.charts.line = await DP.charts.line('lineChart'); 
    if (document.getElementById('radarChart')) state.charts.radar = await DP.charts.radar('radarChart'); 
  } catch(e){ console.warn('drawDashExtras error:', e); }
}

