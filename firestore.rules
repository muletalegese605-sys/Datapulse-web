rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════
    // HELPER FUNCTIONS (no request/resource access)
    // ═══════════════════════════════════════════════════
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email in [
          'muletalegese605@gmail.com',
          'muleta5131@gmail.com'
        ];
    }

    // ═══════════════════════════════════════════════════
    // ORGS
    // ═══════════════════════════════════════════════════
    match /orgs/{orgId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.uid == request.auth.uid);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════
    // DATASETS
    // ═══════════════════════════════════════════════════
    match /datasets/{orgId} {
      allow read, write: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════
    // CONTRACTS
    // ═══════════════════════════════════════════════════
    match /contracts/{contractId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════
    // AUDITS
    // ═══════════════════════════════════════════════════
    match /audits/{auditId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════
    // FULLAUTO
    // ═══════════════════════════════════════════════════
    match /fullauto/{orgId} {
      allow read, write: if isSignedIn();
    }

    // ═══════════════════════════════════════════════════
    // USERS
    // ═══════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() ||
        (isSignedIn() && userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════════════
    // CATCH-ALL — Default deny
    // ═══════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
