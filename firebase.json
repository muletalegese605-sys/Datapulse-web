{
  "hosting": {
    "site": "datapulseapp-20237",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.json.bak",
      "**/.*",
      "**/node_modules/**",
      "run_*.js",
      "server.js",
      "upload_*.js",
      "**/*.sh",
      "firestore.rules",
      "firestore.indexes.json",
      "venv/**",
      "*.py",
      "__pycache__/**"
    ],
    "rewrites": [
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
