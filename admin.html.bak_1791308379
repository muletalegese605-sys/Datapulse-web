function exportAllOrgs() {
  try {
    const rows = state.orgs.map(o => ({
      ID:o.id, Name:o.name, Admin:o.adminName, Email:o.email, Phone:o.phone,
      Type:o.accountType, Plan:o.plan, Status:o.status||'active',
