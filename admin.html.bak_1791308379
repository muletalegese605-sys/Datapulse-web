/* ---------- ERRORS ---------- */
ADM.errors = {
  list: [],
  init() {
    if (this._wired) return;
    this._wired = true;
    const prefs = ADM.gdpr.get();
    if (prefs && !prefs.errors) return;
    window.addEventListener('error', (e) => {
      const m = String(e.message||'');
      if (m.includes('Failed to fetch') || m.includes('NetworkError')) return;
      this.capture(e.error || e.message, { type:'error', file:e.filename, line:e.lineno });
    });
    window.addEventListener('unhandledrejection', (e) => {
      const m = String(e.reason?.message || e.reason || '');
      if (m.includes('Failed to fetch') || m.includes('AbortError')) return;
      this.capture(e.reason, { type:'promise' });
    });
    if (SENTRY_DSN) {
      loadScript('https://browser.sentry-cdn.com/7.114.0/bundle.min.js').then(() => {
        if (window.Sentry) window.Sentry.init({ dsn: SENTRY_DSN, tracesSampleRate: 0.1 });
      }).catch(() => {});
    }
    this.render();
  },
  capture(err, meta) {
    const entry = {
      id:'E-'+Date.now().toString(36),
      msg: String(err && err.message || err || 'Unknown').slice(0, 300),
      stack: String(err && err.stack || '').slice(0, 600),
      meta: meta || {}, at: nowIso(),
      url: location.href, ua: navigator.userAgent
    };
    this.list.unshift(entry);
    if (this.list.length > 50) this.list.pop();
    console.warn('🔴 Admin error:', entry.msg);
    this.render();
  },
  render() {
    const b = document.getElementById('errBadge');
    const c = document.getElementById('errCount');
    if (!b || !c) return;
    if (this.list.length === 0) { b.classList.remove('on'); return; }
    b.classList.add('on');
    if (this.list.some(e => Date.now() - new Date(e.at).getTime() < 60000)) b.classList.add('err');
    else b.classList.remove('err');
    c.textContent = `${this.list.length} error${this.list.length>1?'s':''}`;
  },
  show() {
    if (!this.list.length) { toast('No errors recorded ✓','success'); return; }
    const lines = this.list.slice(0, 10).map((e,i) => `${i+1}. [${new Date(e.at).toLocaleTimeString()}] ${e.msg}`).join('\n\n');
    const choice = confirm(`Admin Error Log (${this.list.length}):\n\n${lines}\n\n---\nOK = Export · Cancel = Clear`);
    if (choice) {
      const blob = new Blob([JSON.stringify(this.list, null, 2)], { type:'application/json' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `datapulse-admin-errors-${Date.now()}.json`; a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 3000);
    } else if (confirm('Clear all error logs?')) {
      this.list = []; this.render();
    }
  }
};

