    persistOrgs();
    ADM.sync.mirrorOrg(newOrg);
    auditLog('ORG_CREATE', newOrg.id, { name });
    toast('Organization created ✓', 'success');
    showResults('Organization Created', `
      <div class="text-[11px] space-y-1">
        <div class="flex justify-between"><span class="text-slate-400">ID:</span><span class="text-white mono">${esc(newOrg.id)}</span></div>
