function saveOrgModal() {
  const id = document.getElementById('orgFormId').value;
  const name = document.getElementById('orgFormName').value.trim();
  const adminName = document.getElementById('orgFormAdmin').value.trim();
  const email = document.getElementById('orgFormEmail').value.trim().toLowerCase();
  const phone = document.getElementById('orgFormPhone').value.trim();
  const accountType = document.getElementById('orgFormType').value;
  const plan = document.getElementById('orgFormPlan').value;
  const status = document.getElementById('orgFormStatus').value;
  const emailVerified = document.getElementById('orgFormVerified').checked;
  if (!name || !email) { toast('Name and email required','error'); return; }
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { toast('Invalid email','error'); return; }
  if (id) {
    const o = state.orgs.find(x => x.id === id);
    if (!o) { toast('Organization not found','error'); return; }
    Object.assign(o, { name, adminName, email, phone, accountType, plan, status, emailVerified, updatedAt: nowIso() });
    if (plan !== 'free' && status !== 'suspended') markPaid(o.id);
    persistOrgs();
    ADM.sync.mirrorOrg(o);
    auditLog('ORG_UPDATE', o.id, { name, plan, status });
    toast('Organization updated ✓', 'success');
    showResults('Organization Updated', `
      <div class="text-[11px] space-y-1">
        <div class="flex justify-between"><span class="text-slate-400">Name:</span><span class="text-white font-bold">${esc(name)}</span></div>
