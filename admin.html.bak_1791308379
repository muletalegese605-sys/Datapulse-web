function confirmDeleteOrg(orgId) {
  const o = state.orgs.find(x => x.id === orgId);
  if (!o) return;
  openConfirm('Delete Organization?', `Delete "${o.name}" (${o.id})? This removes their records and contracts.`, () => {
    state.orgs = state.orgs.filter(x => x.id !== orgId);
    state.contracts = state.contracts.filter(c => c.orgId !== orgId);
    LS.del('dp_records_'+orgId);
    LS.del('dp_trial_'+orgId);
    LS.del('dp_full_auto_'+orgId);
    delete state.records[orgId];
    delete state.fullAutoStats[orgId];
    persistOrgs(); persistContracts(); persistFullAutoStats();
    ADM.sync.deleteOrgCloud(orgId);
    auditLog('ORG_DELETE', orgId, { name:o.name });
    toast('Organization deleted', 'warn');
    render();
  });
}
