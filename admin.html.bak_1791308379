      id:'ORG-'+Date.now().toString().slice(-6), uid:null,
      name, adminName, email, phone, accountType,
      plan, status, emailVerified,
      createdAt: nowIso(), updatedAt: nowIso(), dataCount:0,
      apiKey:'dp_'+Math.random().toString(36).slice(2,14)
    };
    state.orgs.push(newOrg);
