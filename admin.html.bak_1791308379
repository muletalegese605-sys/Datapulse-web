/* ---------- AGGREGATED STATS ---------- */
function aggStats() {
  const totalOrgs = state.orgs.length;
  const activeOrgs = state.orgs.filter(o => o.status !== 'suspended').length;
  const suspendedOrgs = state.orgs.filter(o => o.status === 'suspended').length;
  const verifiedOrgs = state.orgs.filter(o => o.emailVerified).length;
  const paidOrgs = state.orgs.filter(o => isPaid(o.id)).length;
  const activeContracts = state.contracts.filter(c => c.status === 'active').length;
  const cancelledContracts = state.contracts.filter(c => c.status === 'cancelled').length;
  const totalRecords = Object.values(state.records).reduce((s, r) => s + r.length, 0);
  const mrr = state.contracts.filter(c => c.status === 'active').reduce((s, c) => {
    const plan = PLANS.find(p => p.id === c.plan);
    return s + (plan ? plan.usd : 0);
  }, 0);
  const arr = mrr * 12;
  const byPlan = {};
  PLANS.forEach(p => byPlan[p.id] = 0);
  state.orgs.forEach(o => { byPlan[o.plan] = (byPlan[o.plan]||0) + 1; });
  const byType = { individual:0, smb:0, enterprise:0 };
  state.orgs.forEach(o => { if (o.accountType in byType) byType[o.accountType]++; });
  const recentAudits = state.audits.slice(0, 5);
  const fullAutoOnCount = state.orgs.filter(o => fullAutoEnabled(o.id)).length;
  const totalAutoRuns = Object.values(state.fullAutoStats).reduce((s, x) => s + (x.runs||0), 0);
  return { totalOrgs, activeOrgs, suspendedOrgs, verifiedOrgs, paidOrgs, activeContracts, cancelledContracts, totalRecords, mrr, arr, byPlan, byType, recentAudits, fullAutoOnCount, totalAutoRuns };
}

