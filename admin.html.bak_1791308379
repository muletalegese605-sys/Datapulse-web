<div id="loginScreen" class="hidden min-h-screen flex items-center justify-center p-4 bg-slate-950 relative overflow-hidden">
  <div class="hero-glow" style="top:-150px;left:-100px"></div>
  <div class="hero-glow" style="bottom:-200px;right:-100px;background:radial-gradient(circle,rgba(16,185,129,.2),transparent 70%)"></div>
  <div class="w-full max-w-md space-y-4 relative fade z-10">
    <div class="text-center space-y-2">
      <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-400 to-purple-600 text-slate-950 shadow-2xl shadow-purple-500/30">
        <i class="fa-solid fa-shield-halved text-2xl"></i>
      </div>
      <h1 class="text-2xl font-black text-white">DataPulse Admin</h1>
      <p class="text-xs text-purple-400 mono font-bold">CONTROL CENTER · v8.0 · RESTRICTED</p>
    </div>
    <div class="bg-slate-900/90 border border-purple-500/40 rounded-3xl p-5 sm:p-6 space-y-4">
      <div class="p-3 rounded-xl bg-purple-500/10 border border-purple-500/30 flex items-start gap-2">
        <i class="fa-solid fa-triangle-exclamation text-amber-400 mt-0.5"></i>
        <p class="text-[11px] text-slate-300 leading-relaxed">Restricted area. All access attempts are logged and audited. Admin login uses <b class="text-purple-400">Firebase Authentication</b> only.</p>
      </div>
      <form id="adminLoginForm" onsubmit="adminDoLogin(event)" class="space-y-3" novalidate>
        <div>
          <label for="adminEmail" class="text-xs font-semibold text-slate-300 block mb-1.5">Admin Email</label>
          <input type="email" id="adminEmail" required autocomplete="email" placeholder="admin@datapulse.app" class="input mono">
        </div>
        <div>
          <label for="adminPass" class="text-xs font-semibold text-slate-300 block mb-1.5">Firebase Password</label>
          <div class="relative">
            <input type="password" id="adminPass" required autocomplete="current-password" placeholder="••••••••" class="input mono pr-10">
            <button type="button" aria-label="Show password" onclick="togglePw('adminPass',this)" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 hover:text-purple-400"><i class="fa-solid fa-eye"></i></button>
          </div>
        </div>
        <div>
          <label for="admin2FA" class="text-xs font-semibold text-slate-300 block mb-1.5">2FA Code <span class="text-slate-500 font-normal">(optional)</span></label>
          <input type="text" id="admin2FA" maxlength="6" inputmode="numeric" placeholder="000000" class="input mono text-center tracking-[.5em]">
        </div>
        <p id="adminLoginMsg" class="text-rose-400 text-[11px] font-bold text-center" role="alert"></p>
        <button type="submit" class="w-full py-3 bg-purple-500 hover:bg-purple-400 text-slate-950 font-extrabold text-xs rounded-xl">
          <i class="fa-solid fa-right-to-bracket mr-2"></i>Authenticate
