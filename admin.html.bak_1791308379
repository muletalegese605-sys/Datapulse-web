}

function openMarketingHub() {
  showResults('🚀 Marketing Hub', '<div class="space-y-2"><button onclick="previewShare()" class="w-full py-2.5 bg-sky-500/20 border border-sky-500/40 text-sky-400 font-bold text-xs rounded-xl">📱 Preview Share UI</button><button onclick="openContentGenerator()" class="w-full py-2.5 bg-purple-500/20 border border-purple-500/40 text-purple-400 font-bold text-xs rounded-xl">✨ Generate Content</button><button onclick="openScheduler()" class="w-full py-2.5 bg-amber-500/20 border border-amber-500/40 text-amber-400 font-bold text-xs rounded-xl">📅 Schedule Post</button><button onclick="openReferralPanel()" class="w-full py-2.5 bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 font-bold text-xs rounded-xl">🔗 Referrals</button><button onclick="exportOutreachList()" class="w-full py-2.5 bg-rose-500/20 border border-rose-500/40 text-rose-400 font-bold text-xs rounded-xl">📥 Export CSV</button></div>');
}

function previewShare() {
  showResults('📱 Share Preview', '<div class="p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px]"><div class="text-emerald-400 font-black mb-2">Link:</div><code class="text-slate-300 text-[10px] break-all">' + esc(location.origin + '?ref=DP-PREVIEW') + '</code><div class="text-emerald-400 font-black mt-3 mb-2">Message:</div><div class="p-2 rounded-lg bg-slate-900 border-l-4 border-emerald-500"><div class="text-[10px] text-slate-200 whitespace-pre-wrap">🚀 DataPulse — Automate every data workflow!\n\n✓ 40 AI capabilities\n✓ 17 data ops\n✓ Free trial\n\nTry: ' + esc(location.origin) + '</div></div></div>');
}

function openContentGenerator() {
  var fb = LS.get('dp_feedback', []);
  var praise = fb.filter(function(f){ return f.type === 'praise' && f.rating >= 4; }).slice(0, 3);
  var stats = { orgs: state.orgs.length, records: Object.values(state.records||{}).reduce(function(s,r){ return s + r.length; }, 0) };
  showResults('✨ Content Generator', '<div class="space-y-2"><div class="p-3 rounded-lg bg-slate-950 border border-slate-800 text-[11px]"><div class="text-purple-400 font-black mb-1">📊 Stats</div><div class="text-slate-300">• ' + stats.orgs + ' orgs · ' + stats.records + ' records</div></div><div class="p-3 rounded-lg bg-slate-950 border border-slate-800 text-[11px]"><div class="text-emerald-400 font-black mb-1">💚 Praise</div>' + (praise.length ? praise.map(function(p){ return '<div class="text-slate-300 italic mb-1">"' + esc((p.message||'').slice(0,100)) + '"</div>'; }).join('') : '<div class="text-slate-500">None yet</div>') + '</div><button onclick="generatePost(\'twitter\')" class="w-full py-2 bg-sky-500/20 border border-sky-500/40 text-sky-400 font-bold text-xs rounded-xl">🐦 X Post</button><button onclick="generatePost(\'linkedin\')" class="w-full py-2 bg-indigo-500/20 border border-indigo-500/40 text-indigo-400 font-bold text-xs rounded-xl">💼 LinkedIn Post</button><button onclick="generatePost(\'whatsapp\')" class="w-full py-2 bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 font-bold text-xs rounded-xl">📱 WhatsApp</button></div>');
}

function generatePost(channel) {
  var stats = { orgs: state.orgs.length, records: Object.values(state.records||{}).reduce(function(s,r){ return s + r.length; }, 0) };
  var fb = LS.get('dp_feedback', []);
  var praise = fb.filter(function(f){ return f.type === 'praise' && f.rating >= 4; })[0];
  var quote = praise ? '\n\n"' + (praise.message||'').slice(0,120) + '"\n— ' + (praise.userName || 'User') : '';
  var templates = {
    twitter: '🚀 DataPulse growing!\n\n' + stats.orgs + ' orgs · ' + stats.records.toLocaleString() + ' records' + quote + '\n\n40 AI caps + 17 ops, automated.\n\nFree trial 👉 ' + location.origin + '\n\n#DataPulse #AI',
    linkedin: 'Building DataPulse — the all-in-one data platform.\n\n📊 ' + stats.orgs + ' orgs · ' + stats.records.toLocaleString() + ' records' + quote + '\n\nBuilt from Africa 🇪🇹 for the world 🌍.\n\n👉 ' + location.origin,
    whatsapp: '🚀 DataPulse News!\n\n' + stats.orgs + ' orgs use DataPulse.\n\n✓ 40 AI caps\n✓ 17 ops\n✓ Free trial\n\n👉 ' + location.origin
  };
  var text = templates[channel] || templates.twitter;
  copyText(text);
  auditLog('MARKETING_CONTENT_GEN', channel);
  toast(channel.toUpperCase() + ' post copied 📋', 'success');
  showResults('✅ ' + channel.toUpperCase() + ' Ready', '<div class="p-3 rounded-xl bg-slate-950 border border-emerald-500/40"><div class="text-emerald-400 font-black mb-2">📋 Copied</div><pre class="text-slate-300 whitespace-pre-wrap font-mono text-[10px] max-h-64 overflow-y-auto">' + esc(text) + '</pre></div>');
}

function openScheduler() {
  var txt = prompt('Post to schedule:', state.mkCopy || '🚀 DataPulse — Automate your data workflows! Try: ' + location.origin);
  if (!txt) return;
  var when = prompt('When (YYYY-MM-DD HH:MM) or leave blank:', new Date(Date.now()+3600000).toISOString().slice(0,16).replace('T',' '));
  if (when === null) return;
  var sch = state.mkSchedule || [];
  sch.unshift({ id:'SCH-'+Date.now().toString(36), content:txt, when:when || nowIso(), at:nowIso(), by:state.admin.email, status:when?'scheduled':'ready' });
  state.mkSchedule = sch;
  LS.set('dp_mk_schedule', sch);
  copyText(txt);
  auditLog('MARKETING_SCHEDULE', sch[0].id);
  toast('Scheduled + copied! Paste into Buffer/Zapier 📋','success');
  render();
}

function openReferralPanel() {
  var refs = state.mkReferrals || [];
  showResults('🔗 Referral Analytics', '<div class="text-[11px] space-y-2"><div class="p-3 rounded-lg bg-slate-950 border border-emerald-500/30"><div class="text-emerald-400 font-black mb-1">Total: ' + refs.length + '</div><div class="text-slate-400">Each = 1 month Pro free</div></div>' + (refs.length ? refs.slice(0,10).map(function(r){ return '<div class="p-2 rounded bg-slate-950 border border-slate-800 text-[10px]"><div class="text-slate-300">' + esc(r.refCode||'—') + '</div><div class="text-slate-500">' + fmtDate(r.at) + '</div></div>'; }).join('') : '<div class="text-slate-500 text-center py-4">No referrals yet</div>') + '</div>');
}

function exportOutreachList() {
  try {
    var rows = state.orgs.map(function(o){ return { Name:o.name, Admin:o.adminName, Email:o.email, Phone:o.phone, Type:o.accountType, Plan:o.plan, Status:o.status||'active', Paid:isPaid(o.id)?'yes':'no', Joined:o.createdAt, Records:o.dataCount||0 }; });
    if (!rows.length) { toast('No orgs','warn'); return; }
    var h = Object.keys(rows[0]);
    var csv = '\uFEFF' + [h.join(','), rows.map(function(r){ return h.map(function(k){ return '"' + String(r[k]||'').replace(/"/g,'""') + '"'; }).join(','); }).join('\n')].join('\n');
    download(new Blob([csv], { type:'text/csv;charset=utf-8' }), 'datapulse-outreach-' + Date.now() + '.csv');
    auditLog('MARKETING_EXPORT', rows.length + ' orgs');
    toast('Exported ✓','success');
  } catch(e){ toast('Export failed: ' + e.message,'error'); }
}

function publishTestimonials() {
  var fb = LS.get('dp_feedback', []);
  var praise = fb.filter(function(f){ return f.type === 'praise' && f.rating >= 4 && (f.public || f.testimonialApproved); });
  if (!praise.length) { toast('No public praise','warn'); return; }
  LS.set('dp_testimonials', praise.slice(0, 12));
  if (firebaseReady) { try { fbDb.collection('site').doc('testimonials').set({ items:praise.slice(0,12).map(function(p){ return { name:p.userName||p.name||'Anonymous', org:p.orgName||'', rating:p.rating, message:p.message, at:p.at }; }), updatedAt:nowIso() }); } catch(e){} }
  auditLog('MARKETING_TESTIMONIALS_PUBLISH', praise.length);
  toast('Testimonials published ✓','success');
}

function checkSEO() {
  var checks = [
    { name:'Title tag', pass:!!document.querySelector('meta[property="og:title"]') },
    { name:'Description', pass:!!document.querySelector('meta[name="description"]') },
    { name:'OG image', pass:!!document.querySelector('meta[property="og:image"]') },
    { name:'Canonical', pass:!!document.querySelector('link[rel="canonical"]') },
    { name:'Robots', pass:!!document.querySelector('meta[name="robots"]') },
    { name:'Twitter Card', pass:!!document.querySelector('meta[name="twitter:card"]') },
    { name:'Structured data', pass:!!document.querySelector('script[type="application/ld+json"]') },
    { name:'Viewport', pass:!!document.querySelector('meta[name="viewport"]') },
    { name:'HTTPS', pass:location.protocol === 'https:' }
  ];
  var p = checks.filter(function(c){ return c.pass; }).length;
  showResults('🔍 SEO — ' + p + '/' + checks.length, '<div class="space-y-1">' + checks.map(function(c){ return '<div class="flex items-center gap-2 p-2 rounded-lg bg-slate-950 border ' + (c.pass?'border-emerald-500/30':'border-rose-500/30') + ' text-[11px]"><i class="fa-solid ' + (c.pass?'fa-check text-emerald-400':'fa-times text-rose-400') + '"></i><span class="text-slate-300">' + c.name + '</span><span class="ml-auto text-[9px] mono ' + (c.pass?'text-emerald-400':'text-rose-400') + '">' + (c.pass?'PASS':'MISSING') + '</span></div>'; }).join('') + '<a href="https://search.google.com/search-console" target="_blank" class="block w-full py-2 bg-sky-500 text-slate-950 font-black text-[11px] rounded-lg text-center mt-2">Google Search Console →</a></div>');
}

function generateTelegramBot() {
  var instructions = '🤖 Telegram Bot Setup\n\n1. Telegram → @BotFather → /newbot → get token\n2. Add bot as admin to your channel\n3. Get channel ID via @userinfobot\n4. curl -X POST "https://api.telegram.org/botTOKEN/sendMessage" -d "chat_id=ID" -d "text=DataPulse: ' + location.origin + '"\n5. Post ONLY to your own channel.';
  copyText(instructions);
  showResults('🤖 Telegram Bot', '<div class="p-3 rounded-lg bg-slate-950 border border-emerald-500/40"><pre class="text-[10px] text-slate-300 whitespace-pre-wrap font-mono">' + esc(instructions) + '</pre></div><a href="https://t.me/BotFather" target="_blank" class="block w-full py-2 bg-emerald-500 text-slate-950 font-black text-[11px] rounded-lg text-center mt-2">Open BotFather →</a>');
  toast('Instructions copied 📋','success');
}

/* ---------- INIT ---------- */
window.addEventListener('DOMContentLoaded', () => {
  ADM.theme.init();
  ADM.i18n.init();
  ADM.pwa.init();
  ADM.gdpr.show();
  ADM.errors.init();

  try { if (!localStorage.getItem('dp_lang')) localStorage.setItem('dp_lang', 'en'); } catch(e){}
  try { if (!localStorage.getItem('dp_currency')) localStorage.setItem('dp_currency', 'USD'); } catch(e){}

  ADM.currency.renderSelectors();

  if (FIREBASE_ENABLED) {
    try {
      if (window.firebase && !firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
      if (window.firebase) {
        fbAuth = firebase.auth();
        fbDb = firebase.firestore();
        try { fbDb.enablePersistence({ synchronizeTabs:true }).catch(() => {}); } catch(e){}
        firebaseReady = true;
        console.log('✅ Firebase ready (admin v8.0)');
      }
    } catch(e){ console.warn('⚠️ Firebase unavailable:', e.message); }
  } else {
    console.info('ℹ️ Firebase disabled — fill FIREBASE_CONFIG to enable admin login');
  }

  const cs = document.getElementById('currencySel'); if (cs) cs.value = ADM.currency.get();
  startSessionMonitor();

  setTimeout(() => {
    document.getElementById('bootSkeleton').classList.add('hidden');
    const s = ADM.session.check();
    if (s) {
      state.loggedIn = true;
      state.admin = { email:s.email, name:s.name, role:s.role };
      state.sessionExpiresAt = s.expiresAt;
      loadAll();
      enterAdmin();
      toast(`Welcome back, ${s.name}`, 'success');
    } else {
      document.getElementById('loginScreen').classList.remove('hidden');
      document.getElementById('loginScreen').classList.add('flex');
      const ae = document.getElementById('adminEmail'); if (ae) ae.value = ADMIN_EMAIL;
      ADM.sync.setStatus(navigator.onLine ? 'synced' : 'offline');
    }
    checkBackendHealth(false);
  }, 500);
});
</script>
