function deleteFeedback(id) {
  if (!confirm('Delete this feedback permanently?')) return;
  var list = LS.get('dp_feedback', []).filter(function(f){ return f.id !== id; });
  LS.set('dp_feedback', list);
  if (typeof firebaseReady !== 'undefined' && firebaseReady && typeof fbDb !== 'undefined' && fbDb) {
    try { fbDb.collection('feedback').doc(id).delete(); } catch(e){}
  }
  if (typeof auditLog === 'function') auditLog('FEEDBACK_DELETE', id);
  if (typeof toast === 'function') toast('Feedback deleted','warn');
  render();
}

ADM.feedbackPullFromCloud = async function() {
  if (typeof firebaseReady === 'undefined' || !firebaseReady || !fbDb) {
    if (typeof toast === 'function') toast('Firebase not connected','warn');
    return;
  }
  try {
    if (typeof toast === 'function') toast('Pulling from cloud…','info');
    var snap = await fbDb.collection('feedback').orderBy('at','desc').limit(500).get().catch(function(){
      return fbDb.collection('feedback').limit(500).get();
    });
    var remote = snap.docs.map(function(d){ var o = d.data(); o.id = d.id; return o; });
    var local = LS.get('dp_feedback', []);
    var map = new Map();
    local.concat(remote).forEach(function(f){
      var prev = map.get(f.id);
      if (!prev) { map.set(f.id, f); return; }
      var tPrev = new Date(prev.at || 0).getTime();
      var tNew  = new Date(f.at || 0).getTime();
      map.set(f.id, tNew >= tPrev ? Object.assign({}, prev, f) : Object.assign({}, f, prev));
    });
    var merged = Array.from(map.values()).sort(function(a,b){
      return new Date(b.at || 0) - new Date(a.at || 0);
    });
    LS.set('dp_feedback', merged.slice(0, 500));
    if (typeof toast === 'function') toast('Pulled ' + remote.length + ' feedback ✓','success');
    if (typeof render === 'function') render();
  } catch(e) {
    if (typeof toast === 'function') toast('Pull failed: ' + e.message,'error');
  }
};


