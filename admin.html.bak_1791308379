  var detractors = npsList.filter(function(f){ return f.nps <= 6; }).length;
  var nps = npsList.length ? Math.round((promoters - detractors) / npsList.length * 100) : null;
  var avg = list.length ? (list.reduce(function(s,f){ return s + (f.rating||0); }, 0) / list.length).toFixed(2) : '0.00';
