    if (npsScore != null && npsScore < 30) insights.push({ priority:'high', color:'rose', icon:'fa-face-frown', title:'NPS below target (' + npsScore + ')', detail:'Target 30+. Reach out to detractors.', action:"go('feedback')", actionLabel:'Review' });
    if (errCount > 5) insights.push({ priority:'high', color:'rose', icon:'fa-bug', title:errCount + ' errors logged', detail:'Open Sentry to triage.', action:'ADM.errors.show()', actionLabel:'Log' });
    if (!isNaN(parseFloat(avgRating)) && parseFloat(avgRating) < 4.0 && feedback.length >= 3) insights.push({ priority:'high', color:'amber', icon:'fa-star-half-stroke', title:'Avg rating ' + avgRating + '/5', detail:'Below 4.0. Fix root causes.', action:"go('feedback')", actionLabel:'Read' });
