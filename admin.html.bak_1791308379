    else if (s.paidOrgs === 0) insights.push({ priority:'high', color:'amber', icon:'fa-credit-card', title:'No paying users yet', detail:s.totalOrgs + ' free users. Ask 3 why.', action:"go('feedback')", actionLabel:'Ask' });
