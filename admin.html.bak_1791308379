function exportMeasurements() {
  try {
    var s = aggStats();
    var feedback = LS.get('dp_feedback', []);
    var npsList = feedback.filter(function(f){ return f.nps != null; });
    var npsScore = npsList.length ? Math.round((npsList.filter(function(f){return f.nps>=9;}).length/npsList.length - npsList.filter(function(f){return f.nps<=6;}).length/npsList.length) * 100) : 0;
    var rows = [
      { Metric:'Organizations (total)', Value: s.totalOrgs },
      { Metric:'Organizations (paid)', Value: s.paidOrgs },
      { Metric:'Conversion rate %', Value: s.totalOrgs > 0 ? (s.paidOrgs/s.totalOrgs*100).toFixed(2) : '0' },
      { Metric:'Churn rate %', Value: s.totalOrgs > 0 ? (s.cancelledContracts/s.totalOrgs*100).toFixed(2) : '0' },
      { Metric:'Active contracts', Value: s.activeContracts },
      { Metric:'MRR (USD)', Value: s.mrr },
      { Metric:'ARR (USD)', Value: s.arr },
      { Metric:'ARPU (USD)', Value: s.paidOrgs > 0 ? (s.mrr/s.paidOrgs).toFixed(2) : '0' },
      { Metric:'Total records', Value: s.totalRecords },
      { Metric:'Feedback entries', Value: feedback.length },
      { Metric:'Avg rating', Value: feedback.length ? (feedback.reduce(function(a,f){return a+(f.rating||0);},0)/feedback.length).toFixed(2) : '0' },
