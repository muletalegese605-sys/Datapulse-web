/* ---------- FETCH ---------- */
ADM.fetch = async (url, opts={}) => {
  const attempts = opts._retries ?? 0;
  const ctrl = new AbortController();
  const timeoutMs = opts._timeout || ADM.config.requestTimeout;
  const t = setTimeout(() => ctrl.abort(), timeoutMs);
  try {
    const { _timeout, _retries, ...rest } = opts;
    const res = await fetch(url, { ...rest, signal: ctrl.signal });
    clearTimeout(t);
    return res;
  } catch(err) {
    clearTimeout(t);
    if (attempts < 2 && err.name !== 'AbortError') {
      await new Promise(r => setTimeout(r, 800 * (attempts+1)));
      return ADM.fetch(url, { ...opts, _retries: attempts+1 });
    }
    throw err;
  }
};

/* ---------- TOAST ---------- */
function toast(msg, type='info') {
  const c = document.getElementById('toasts'); if (!c) return;
  const colors = { success:'border-emerald-500 text-emerald-300', error:'border-rose-500 text-rose-300', info:'border-sky-500 text-sky-300', warn:'border-amber-500 text-amber-300' };
  const icons = { success:'fa-circle-check', error:'fa-circle-exclamation', info:'fa-circle-info', warn:'fa-triangle-exclamation' };
  const t = document.createElement('div');
  t.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl border shadow-xl backdrop-blur text-xs font-semibold max-w-xs bg-slate-900/90 ${colors[type]||colors.info} toast-in`;
  t.setAttribute('role', type === 'error' ? 'alert' : 'status');
  t.innerHTML = `<i class="fa-solid ${icons[type]||icons.info}"></i><span>${esc(msg)}</span>`;
  c.appendChild(t);
  setTimeout(() => { t.style.opacity='0'; t.style.transform='translateX(60px)'; setTimeout(()=>t.remove(), 300); }, 3400);
}

