function cancelContract(id) {
  const c = state.contracts.find(x => x.id === id);
  if (!c) return;
  openConfirm('Cancel Contract?', `Cancel ${c.id} for ${c.orgName}?`, () => {
    c.status = 'cancelled'; c.cancelledAt = nowIso(); c.updatedAt = nowIso();
    const org = state.orgs.find(o => o.id === c.orgId);
    if (org) { org.plan = 'free'; org.updatedAt = nowIso(); unmarkPaid(org.id); }
    persistContracts(); persistOrgs();
    ADM.sync.mirrorContract(c);
    if (org) ADM.sync.mirrorOrg(org);
    auditLog('CONTRACT_CANCEL', id);
    toast('Contract cancelled', 'warn');
    render();
  });
}
function deleteContract(id) {
  openConfirm('Delete Contract?', 'Permanently remove this contract record? If active, the org will also revert to Free.', () => {
    const c = state.contracts.find(x => x.id === id);
    if (c && c.status === 'active') {
      const org = state.orgs.find(o => o.id === c.orgId);
      if (org) { org.plan = 'free'; org.updatedAt = nowIso(); unmarkPaid(org.id); persistOrgs(); ADM.sync.mirrorOrg(org); }
    }
    state.contracts = state.contracts.filter(c => c.id !== id);
    persistContracts();
    ADM.sync.deleteContractCloud(id);
    auditLog('CONTRACT_DELETE', id);
    toast('Contract deleted', 'warn');
    render();
  });
}
