                <button onclick="toggleFullAuto('${esc(o.id)}')" title="${faOn?'Disable':'Enable'} Full Auto" class="px-2 py-1 bg-slate-800 hover:bg-slate-700 ${faOn?'text-amber-400':'text-slate-500'} rounded-lg text-[10px]"><i class="fa-solid fa-bolt"></i></button>
