function loadAll() {
  state.orgs = LS.get('dp_orgs', []);
  state.contracts = LS.get('dp_contracts', []);
  state.audits = LS.get('dp_audits', []);
  state.records = {};
  state.fullAutoStats = LS.get('dp_full_auto_stats', {});
  state.orgs.forEach(o => {
    state.records[o.id] = LS.get('dp_records_'+o.id, []);
    const fa = LS.get('dp_full_auto_'+o.id, null);
    if (fa) state.fullAutoStats[o.id] = fa;
    const globalFlag = LS.get('dp_full_auto', false);
    if (globalFlag && !state.fullAutoStats[o.id]) state.fullAutoStats[o.id] = { enabled:true, runs:0, capsRun:40, opsRun:17, lastRun:null };
  });
  if (!state.currentDataset && state.orgs.length) state.currentDataset = state.orgs[0].id;
}
function persistOrgs(){ LS.set('dp_orgs', state.orgs); }
function persistContracts(){ LS.set('dp_contracts', state.contracts); }
function persistAudits(){ LS.set('dp_audits', state.audits.slice(0, 500)); }
function persistRecords(orgId){ LS.set('dp_records_'+orgId, state.records[orgId] || []); }
function persistFullAutoStats(){ LS.set('dp_full_auto_stats', state.fullAutoStats); }

function auditLog(action, target='N/A', payload=null) {
  const entry = {
    id:'LOG-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,5),
    action, target: String(target).slice(0, 100),
    org:'ADMIN', status:'SUCCESS',
    at: nowIso(), performed_at: nowIso(),
    item_id: String(target).slice(0,100),
    payload: payload || {}
  };
  state.audits.unshift(entry);
  if (state.audits.length > ADM.config.maxAudits) state.audits.pop();
  persistAudits();
  ADM.sync.mirrorAudit(entry);
}

/* ---------- SYNC ENGINE ---------- */
ADM.sync = {
  status: 'synced',
  lastPushAt: 0, lastPullAt: 0,
  inflight: false, unsubs: [],

  loadQueue() { return LS.get(SYNC_QUEUE_KEY, []); },
  saveQueue(q) { LS.set(SYNC_QUEUE_KEY, q.slice(0, 500)); },
  enqueue(op) {
    const q = this.loadQueue();
    const key = `${op.kind}:${op.id}`;
    const idx = q.findIndex(x => `${x.kind}:${x.id}` === key);
    const item = { ...op, ts: Date.now(), retries: 0 };
    if (idx >= 0) q[idx] = item; else q.push(item);
    this.saveQueue(q);
    this.setStatus('pending');
  },
  clearQueue() { LS.set(SYNC_QUEUE_KEY, []); },

  setStatus(s) {
    this.status = s;
    const b = document.getElementById('syncBadge');
    const t = document.getElementById('syncBadgeText');
    if (b) b.className = 'sync-badge ' + s + ' hidden sm:inline-flex';
    if (t) t.textContent = ({ synced:'Synced', syncing:'Syncing…', pending:`Pending (${this.loadQueue().length})`, error:'Sync error', offline:'Offline' })[s] || s;
  },

  async mirrorOrg(org) {
    if (!firebaseReady || !org) return;
    try { await fbDb.collection('orgs').doc(org.id).set(org, { merge:true }); this.setStatus('synced'); }
    catch(e){ this.enqueue({ kind:'org', op:'upsert', id:org.id, data:org }); }
  },
  async mirrorContract(c) {
    if (!firebaseReady || !c) return;
    try { await fbDb.collection('contracts').doc(c.id).set(c, { merge:true }); }
    catch(e){ this.enqueue({ kind:'contract', op:'upsert', id:c.id, data:c }); }
  },
  async mirrorAudit(a) {
    if (!firebaseReady || !a) return;
    try { await fbDb.collection('audits').doc(a.id).set(a, { merge:true }); } catch(e){}
  },
  async mirrorRecords(orgId) {
    if (!firebaseReady || !orgId) return;
    const recs = state.records[orgId] || [];
    try {
      await fbDb.collection('datasets').doc(orgId).set({ records: recs, updatedAt: nowIso(), orgName: state.orgs.find(o => o.id === orgId)?.name || '—' }, { merge:true });
    } catch(e){ this.enqueue({ kind:'records', op:'upsert', id:orgId, data:recs }); }
  },
  async deleteOrgCloud(orgId) {
    if (!firebaseReady) return;
    try {
      await fbDb.collection('datasets').doc(orgId).delete().catch(() => {});
      await fbDb.collection('orgs').doc(orgId).delete();
      await fbDb.collection('fullauto').doc(orgId).delete().catch(() => {});
    } catch(e){ this.enqueue({ kind:'org', op:'delete', id:orgId }); }
  },
  async deleteContractCloud(id) {
    if (!firebaseReady) return;
    try { await fbDb.collection('contracts').doc(id).delete(); }
    catch(e){ this.enqueue({ kind:'contract', op:'delete', id }); }
  },

  async pullAll(verbose) {
    if (!firebaseReady) {
      if (verbose) toast('Firebase config not set — local mode', 'info');
      return false;
    }
    if (this.inflight) return false;
    this.inflight = true;
    this.setStatus('syncing');
    try {
      const [orgsSnap, ctrSnap, auditSnap] = await Promise.all([
        fbDb.collection('orgs').get(),
        fbDb.collection('contracts').get(),
        fbDb.collection('audits').orderBy('performed_at','desc').limit(500).get().catch(() => fbDb.collection('audits').limit(500).get())
      ]);
      const remoteOrgs = orgsSnap.docs.map(d => ({ id:d.id, ...d.data() }));
      state.orgs = this._merge(state.orgs, remoteOrgs);
      persistOrgs();
      const remoteCtr = ctrSnap.docs.map(d => ({ id:d.id, ...d.data() }));
      state.contracts = this._merge(state.contracts, remoteCtr);
      persistContracts();
      const remoteAudits = auditSnap.docs.map(d => ({ id:d.id, ...d.data() }));
      const auditMap = new Map();
      [...state.audits, ...remoteAudits].forEach(a => auditMap.set(a.id, a));
      state.audits = Array.from(auditMap.values()).sort((a,b) => new Date(b.performed_at||b.at||0) - new Date(a.performed_at||a.at||0)).slice(0, ADM.config.maxAudits);
      persistAudits();
      for (const o of state.orgs.slice(0, 30)) {
        try {
          const dsDoc = await fbDb.collection('datasets').doc(o.id).get();
          if (dsDoc.exists) {
            const recs = dsDoc.data().records || [];
            if (recs.length) { state.records[o.id] = recs; persistRecords(o.id); }
          }
        } catch(e){}
      }
      try {
        const faSnap = await fbDb.collection('fullauto').get();
        faSnap.forEach(d => { state.fullAutoStats[d.id] = d.data(); });
        persistFullAutoStats();
      } catch(e){}
      this.lastPullAt = Date.now();
      LS.set(SYNC_META_KEY, { lastPullAt: this.lastPullAt, lastPushAt: this.lastPushAt });
      this.setStatus('synced');
      if (verbose) {
        toast(`Pulled ${remoteOrgs.length} orgs, ${remoteCtr.length} contracts`, 'success');
        showResults('Cloud Pull Complete', `
          <div class="grid grid-cols-2 gap-2 text-[11px]">
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Organizations</div><div class="text-purple-400 font-black mono">${remoteOrgs.length}</div></div>
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Contracts</div><div class="text-emerald-400 font-black mono">${remoteCtr.length}</div></div>
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Audits</div><div class="text-sky-400 font-black mono">${remoteAudits.length}</div></div>
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Full Auto Orgs</div><div class="text-amber-400 font-black mono">${Object.values(state.fullAutoStats).filter(s => s.enabled).length}</div></div>
          </div>
        `);
      }
      if (state.loggedIn) render();
      return true;
    } catch(e) {
      this.setStatus('error');
      if (verbose) toast('Pull failed: ' + e.message, 'error');
      return false;
    } finally { this.inflight = false; }
  },

  async pushAll(verbose) {
    if (this.inflight) return false;
    this.inflight = true;
    this.setStatus('syncing');
    try {
      if (firebaseReady) {
        const orgChunks = [];
        for (let i = 0; i < state.orgs.length; i += 400) orgChunks.push(state.orgs.slice(i, i+400));
        for (const chunk of orgChunks) {
          const batch = fbDb.batch();
          chunk.forEach(o => batch.set(fbDb.collection('orgs').doc(o.id), o, { merge:true }));
          await batch.commit();
        }
        const cChunks = [];
        for (let i = 0; i < state.contracts.length; i += 400) cChunks.push(state.contracts.slice(i, i+400));
        for (const chunk of cChunks) {
          const batch = fbDb.batch();
          chunk.forEach(c => batch.set(fbDb.collection('contracts').doc(c.id), c, { merge:true }));
          await batch.commit();
        }
        const recent = state.audits.slice(0, 200);
        const aChunks = [];
        for (let i = 0; i < recent.length; i += 400) aChunks.push(recent.slice(i, i+400));
        for (const chunk of aChunks) {
          const batch = fbDb.batch();
          chunk.forEach(a => batch.set(fbDb.collection('audits').doc(a.id), a, { merge:true }));
          await batch.commit();
        }
        try {
          const faEntries = Object.entries(state.fullAutoStats);
          const faChunks = [];
          for (let i = 0; i < faEntries.length; i += 400) faChunks.push(faEntries.slice(i, i+400));
          for (const chunk of faChunks) {
            const batch = fbDb.batch();
            chunk.forEach(([orgId, stats]) => batch.set(fbDb.collection('fullauto').doc(orgId), stats, { merge:true }));
            await batch.commit();
          }
        } catch(e){}
      }
      await this._pushBackend({ orgs: state.orgs, contracts: state.contracts, audits: state.audits.slice(0, 200), fullAutoStats: state.fullAutoStats });
      this.lastPushAt = Date.now();
      LS.set(SYNC_META_KEY, { lastPullAt: this.lastPullAt, lastPushAt: this.lastPushAt });
      this.setStatus('synced');
      if (verbose) {
        toast('Pushed to cloud ✓', 'success');
        showResults('Cloud Push Complete', `
          <div class="grid grid-cols-2 gap-2 text-[11px]">
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Orgs Pushed</div><div class="text-purple-400 font-black mono">${state.orgs.length}</div></div>
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Contracts</div><div class="text-emerald-400 font-black mono">${state.contracts.length}</div></div>
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Audits</div><div class="text-sky-400 font-black mono">${state.audits.slice(0,200).length}</div></div>
            <div class="p-2 rounded-lg bg-slate-950/60 border border-slate-800"><div class="text-slate-400 text-[9px]">Full Auto</div><div class="text-amber-400 font-black mono">${Object.keys(state.fullAutoStats).length} orgs</div></div>
          </div>
        `);
      }
      return true;
    } catch(e) {
      this.setStatus('error');
      if (verbose) toast('Push failed: ' + e.message, 'error');
      return false;
    } finally { this.inflight = false; }
  },

  async _pushBackend(payload) {
    const url = (LS.get('dp_backend', BACKEND_URL) || BACKEND_URL).replace(/\/$/,'');
    try {
      const res = await ADM.fetch(url + '/api/sync/bulk', {
        method:'POST',
        headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify({ ...payload, pushedAt: nowIso() }),
        _timeout: 15000
      });
      return res.ok;
    } catch(e) {
      payload.orgs?.forEach(o => this.enqueue({ kind:'org', op:'upsert', id:o.id, data:o }));
      return false;
    }
  },

  async flushQueue() {
    if (!state.online || this.inflight) return;
    const q = this.loadQueue();
    if (!q.length) return;
    this.setStatus('syncing');
    const url = (LS.get('dp_backend', BACKEND_URL) || BACKEND_URL).replace(/\/$/,'');
    const remaining = [];
    for (const op of q) {
      try {
        if (firebaseReady) {
          if (op.kind === 'org' && op.op === 'upsert') await fbDb.collection('orgs').doc(op.id).set(op.data, { merge:true });
          else if (op.kind === 'org' && op.op === 'delete') await fbDb.collection('orgs').doc(op.id).delete();
          else if (op.kind === 'contract' && op.op === 'upsert') await fbDb.collection('contracts').doc(op.id).set(op.data, { merge:true });
          else if (op.kind === 'contract' && op.op === 'delete') await fbDb.collection('contracts').doc(op.id).delete();
          else if (op.kind === 'records') await this.mirrorRecords(op.id);
        }
        ADM.fetch(url + '/api/sync/op', { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(op), _timeout: 8000 }).catch(() => {});
      } catch(e) {
        op.retries = (op.retries||0) + 1;
        if (op.retries < ADM.config.syncMaxRetries) remaining.push(op);
      }
    }
    this.saveQueue(remaining);
    this.setStatus(remaining.length ? 'pending' : 'synced');
  },

  subscribe() {
    if (!firebaseReady) return;
    this.unsubs.forEach(u => { try { u(); } catch(e){} });
    this.unsubs = [];
    this.unsubs.push(fbDb.collection('orgs').onSnapshot(snap => {
      let changed = false;
      snap.docChanges().forEach(ch => {
        if (ch.type === 'removed') { const idx = state.orgs.findIndex(o => o.id === ch.doc.id); if (idx >= 0) { state.orgs.splice(idx, 1); changed = true; } }
        else { const data = { id: ch.doc.id, ...ch.doc.data() }; const idx = state.orgs.findIndex(o => o.id === data.id); if (idx >= 0) state.orgs[idx] = { ...state.orgs[idx], ...data }; else state.orgs.push(data); changed = true; }
      });
      if (changed) { persistOrgs(); if (state.loggedIn) render(); }
    }, err => console.warn('orgs listener:', err.message)));
    this.unsubs.push(fbDb.collection('contracts').onSnapshot(snap => {
      let changed = false;
      snap.docChanges().forEach(ch => {
        if (ch.type === 'removed') { const idx = state.contracts.findIndex(c => c.id === ch.doc.id); if (idx >= 0) { state.contracts.splice(idx, 1); changed = true; } }
        else { const data = { id: ch.doc.id, ...ch.doc.data() }; const idx = state.contracts.findIndex(c => c.id === data.id); if (idx >= 0) state.contracts[idx] = { ...state.contracts[idx], ...data }; else state.contracts.push(data); changed = true; }
      });
      if (changed) { persistContracts(); if (state.loggedIn) render(); }
    }, err => console.warn('contracts listener:', err.message)));
    this.unsubs.push(fbDb.collection('fullauto').onSnapshot(snap => {
      let changed = false;
      snap.docChanges().forEach(ch => {
        if (ch.type === 'removed') { delete state.fullAutoStats[ch.doc.id]; changed = true; }
        else { state.fullAutoStats[ch.doc.id] = ch.doc.data(); changed = true; }
      });
      if (changed) { persistFullAutoStats(); if (state.loggedIn) render(); }
    }, err => console.warn('fullauto listener:', err.message)));
  },

  _merge(localArr, remoteArr) {
    const map = new Map();
    [...localArr, ...remoteArr].forEach(item => {
      const key = item.id;
      const prev = map.get(key);
      if (!prev) { map.set(key, item); return; }
      const tLocal = new Date(prev.updatedAt || prev.createdAt || 0).getTime();
      const tRemote = new Date(item.updatedAt || item.createdAt || 0).getTime();
      map.set(key, tRemote >= tLocal ? { ...prev, ...item } : { ...item, ...prev });
    });
    return Array.from(map.values());
  },

  async init() {
    this.setStatus(state.online ? 'synced' : 'offline');
    const meta = LS.get(SYNC_META_KEY, {});
    this.lastPullAt = meta.lastPullAt || 0;
    this.lastPushAt = meta.lastPushAt || 0;
    if (firebaseReady) {
      this.subscribe();
      if (Date.now() - this.lastPullAt > 60000) await this.pullAll(false);
    }
    this.flushQueue();
    setInterval(() => this.flushQueue(), ADM.config.syncFlushIntervalMs);
  }
};

/* ---------- SECURITY ---------- */
ADM.security = {
  attemptKey: 'dp_admin_attempts',
  checkRateLimit() {
    const now = Date.now();
    const a = LS.get(this.attemptKey, []).filter(t => now - t < ADM.config.rateLimitWindowMs);
    LS.set(this.attemptKey, a);
    if (a.length >= ADM.config.rateLimitAttempts) return { blocked:true, wait: Math.ceil((ADM.config.rateLimitWindowMs - (now - a[0]))/1000) };
    return { blocked:false };
  },
  recordAttempt() { const a = LS.get(this.attemptKey, []); a.push(Date.now()); LS.set(this.attemptKey, a); },
  clearAttempts() { LS.del(this.attemptKey); }
};

/* ---------- SESSION ---------- */
ADM.session = {
  set() {
    const session = { email: ADMIN_EMAIL, name: 'Muleta Legese Gemeda', role: 'super-admin', startedAt: Date.now(), expiresAt: Date.now() + SESSION_TTL_MS };
    LS.set(SESSION_KEY, session);
    state.sessionExpiresAt = session.expiresAt;
  },
  check() {
    const s = LS.get(SESSION_KEY, null);
    if (!s || Date.now() > s.expiresAt) { LS.del(SESSION_KEY); return null; }
    return s;
  },
  clear() { LS.del(SESSION_KEY); },
  refresh() {
    const s = LS.get(SESSION_KEY, null);
    if (s) { s.expiresAt = Date.now() + SESSION_TTL_MS; LS.set(SESSION_KEY, s); state.sessionExpiresAt = s.expiresAt; }
  }
};

let sessionTicker = null;
function startSessionTimerUI() {
  if (sessionTicker) clearInterval(sessionTicker);
  const badge = document.getElementById('sessionBadge');
  if (badge) badge.classList.remove('hidden');
  sessionTicker = setInterval(() => {
    if (!state.loggedIn) return;
    const el = document.getElementById('sessionTimer');
    if (!el) return;
    const remaining = Math.max(0, state.sessionExpiresAt - Date.now());
    const m = Math.floor(remaining / 60000);
    const s = Math.floor((remaining % 60000) / 1000);
    el.textContent = `${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
    if (remaining < 5 * 60000) el.classList.add('text-rose-400');
    else el.classList.remove('text-rose-400');
  }, 1000);
}

/* ---------- TRIAL HELPERS ---------- */
function getTrial(orgId) { return LS.get('dp_trial_'+orgId, null); }
function trialDaysLeft(orgId) {
  const t = getTrial(orgId); if (!t) return 0;
  return Math.max(0, Math.ceil((new Date(t.endsAt) - Date.now()) / 86400000));
}
function isPaid(orgId) {
  const t = getTrial(orgId); if (t && t.paid) return true;
  return state.contracts.some(c => c.orgId === orgId && c.status === 'active' && c.plan !== 'free');
}
function markPaid(orgId) {
  const t = getTrial(orgId) || { startedAt: nowIso(), endsAt: nowIso(), paid:false };
  t.paid = true; t.paidAt = nowIso();
  LS.set('dp_trial_'+orgId, t);
}
function unmarkPaid(orgId) {
  const t = getTrial(orgId);
  if (t) { t.paid = false; t.paidAt = null; LS.set('dp_trial_'+orgId, t); }
}

/* ---------- FULL AUTO HELPERS ---------- */
function getFullAutoStats(orgId) {
  const stored = LS.get('dp_full_auto_'+orgId, null);
  if (stored) return stored;
  const cached = state.fullAutoStats[orgId];
  if (cached) return cached;
  const globalFlag = LS.get('dp_full_auto', false);
  return { enabled: !!globalFlag, runs:0, capsRun: globalFlag?40:0, opsRun: globalFlag?17:0, lastRun:null };
}
function fullAutoEnabled(orgId) {
  const s = getFullAutoStats(orgId);
  return !!(s && s.enabled);
}

