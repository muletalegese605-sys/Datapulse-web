async function adminDoLogin(e) {
  e.preventDefault();
  const rl = ADM.security.checkRateLimit();
  if (rl.blocked) {
    document.getElementById('adminLoginMsg').textContent = `Too many attempts. Wait ${rl.wait}s`;
    return;
  }
  const email = document.getElementById('adminEmail').value.trim().toLowerCase();
  const pw = document.getElementById('adminPass').value;
  const tfa = document.getElementById('admin2FA').value.trim();
  document.getElementById('adminLoginMsg').textContent = '';
  if (!email || !pw) { toast('Fill all required fields','error'); return; }
  if (email !== ADMIN_EMAIL) {
    ADM.security.recordAttempt();
    document.getElementById('adminLoginMsg').textContent = 'Access denied. Not an admin account.';
    toast('Access denied', 'error');
    return;
  }
  if (tfa && !/^\d{6}$/.test(tfa)) { toast('2FA must be 6 digits','error'); return; }
  const btn = e.target.querySelector('button[type="submit"]');
  btn.disabled = true; const orig = btn.innerHTML;
  btn.innerHTML = '<i class="fa-solid fa-spinner spin mr-2"></i>Authenticating…';
  try {
    if (!firebaseReady) throw new Error("Firebase not configured. Add config in Firebase Console.");
    const cred = await fbAuth.signInWithEmailAndPassword(ADMIN_EMAIL, pw);
    if (!cred || !cred.user || cred.user.email.toLowerCase() !== ADMIN_EMAIL.toLowerCase()) {
      await fbAuth.signOut().catch(() => {});
      throw new Error('Authenticated user is not the admin.');
    }
    ADM.security.clearAttempts();
    ADM.session.set();
    state.admin = { email: ADMIN_EMAIL, name: 'Muleta Legese Gemeda', role: 'super-admin' };
    state.loggedIn = true;
    loadAll();
    auditLog('ADMIN_LOGIN', ADMIN_EMAIL);
    enterAdmin();
    toast('👑 Admin access granted', 'success');
    ADM.analytics.event('admin_login', { email });
  } catch(err) {
    ADM.security.recordAttempt();
    let msg = err.message || 'Login failed';
    if (msg.includes('auth/invalid-credential') || msg.includes('auth/wrong-password')) msg = 'Invalid email or password.';
    if (msg.includes('auth/user-not-found')) msg = 'Admin account not found. Create it in Firebase Console → Authentication → Users.';
    if (msg.includes('auth/too-many-requests')) msg = 'Too many attempts. Try later.';
    document.getElementById('adminLoginMsg').textContent = msg;
    toast(msg, 'error');
    ADM.errors.capture(err, { context:'admin_login' });
    btn.disabled = false; btn.innerHTML = orig;
  }
}

