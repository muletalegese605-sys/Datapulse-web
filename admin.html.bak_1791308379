function exportAudit() {
  try {
    const rows = state.audits.map(a => ({ ID:a.id, Action:a.action, Target:a.target||a.item_id, Org:a.org, Status:a.status||'SUCCESS', Time:a.performed_at||a.at }));
    if (!rows.length) { toast('No data','warn'); return; }
    const h = Object.keys(rows[0]);
    const csv = '\uFEFF' + [h.join(','), ...rows.map(r => h.map(k => `"${String(r[k]??'').replace(/"/g,'""')}"`).join(','))].join('\n');
    download(new Blob([csv], { type:'text/csv;charset=utf-8' }), `datapulse-audit-${Date.now()}.csv`);
    toast('Audit exported ✓','success');
  } catch(e){ toast('Export failed: '+e.message,'error'); }
}
function clearAudits() {
  openConfirm('Clear All Audit Logs?', 'This permanently removes all audit entries.', () => {
    state.audits = [];
    persistAudits();
    toast('Audit logs cleared','warn');
    render();
  });
}

