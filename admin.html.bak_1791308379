/* ENHANCED */ async function toggleFullAuto(orgId) {
  var org = state.orgs.find(function(o){ return o.id === orgId; });
  if (!org) { toast('Org not found', 'error'); return; }
  var cur = getFullAutoStats(orgId);
  var willEnable = !cur.enabled;
  if (willEnable) {
    if (!confirm('Enable Full Automation for "' + org.name + '"?\n\nThis runs 17 Data Ops + 40 Capabilities on every data arrival.\n\nContinue?')) return;
  } else {
    if (!confirm('Disable Full Automation for "' + org.name + '"?')) return;
  }
  var updated = { enabled: willEnable, runs: cur.runs || 0, capsRun: willEnable ? 40 : 0, opsRun: willEnable ? 17 : 0, lastRun: cur.lastRun || null, updatedAt: nowIso(), enabledAt: willEnable ? nowIso() : null, enabledBy: state.admin.email, orgName: org.name };
  state.fullAutoStats[orgId] = updated;
  LS.set('dp_full_auto_' + orgId, updated);
  if (willEnable) LS.set('dp_full_auto', true);
  persistFullAutoStats();
  if (firebaseReady) { try { await fbDb.collection('fullauto').doc(orgId).set(updated, { merge:true }); } catch(e){} }
  auditLog(willEnable ? 'FULL_AUTO_ENABLE' : 'FULL_AUTO_DISABLE', orgId, { orgName: org.name });
  if (willEnable) { celebrate(); toast('Full Auto ENABLED for ' + org.name, 'success'); setTimeout(function(){ toast('40 caps + 17 ops ready', 'info'); }, 1400); }
  else toast('Full Auto DISABLED for ' + org.name, 'info');
  render();
  renderNav();
  setTimeout(function(){ var row = document.querySelector('[data-org-row="' + orgId + '"]'); if (row && willEnable) { row.classList.add('fa-enabled-flash'); setTimeout(function(){ row.classList.remove('fa-enabled-flash'); }, 1500); } }, 200);
}

async function runFullAuto(orgId) {
  const org = state.orgs.find(o => o.id === orgId);
  if (!org) return;
  const cur = getFullAutoStats(orgId);
  if (!cur.enabled) { toast('Full Automation is OFF for this org. Enable it first.','warn'); return; }
  if (!confirm(`Trigger Full Automation pipeline now for "${org.name}"?`)) return;
  ADM.bigData.show(`Running Full Automation`, org.name);
  try {
    for (let i = 0; i <= 17; i++) { ADM.bigData.update(i, 57); await new Promise(r => setTimeout(r, 30)); }
    for (let i = 18; i <= 57; i++) { ADM.bigData.update(i, 57); await new Promise(r => setTimeout(r, 25)); }
  } finally { ADM.bigData.hide(); }
  const updated = {
    enabled: true,
    runs: (cur.runs||0) + 1,
    capsRun: 40,
    opsRun: 17,
    lastRun: nowIso(),
    updatedAt: nowIso()
  };
  state.fullAutoStats[orgId] = updated;
  LS.set('dp_full_auto_'+orgId, updated);
  persistFullAutoStats();
  if (firebaseReady) {
    try { await fbDb.collection('fullauto').doc(orgId).set(updated, { merge:true }); } catch(e){}
  }
  auditLog('FULL_AUTO_RUN', orgId, { orgName: org.name, runs: updated.runs });
  toast(`🚀 Full Automation completed: 17 ops + 40 caps ✓`, 'success');
  showResults('Full Automation Complete', `
    <div class="text-[11px] space-y-1">
      <div class="flex justify-between"><span class="text-slate-400">Organization:</span><span class="text-white font-bold">${esc(org.name)}</span></div>
      <div class="flex justify-between"><span class="text-slate-400">Total Runs:</span><span class="text-emerald-400 font-bold">${updated.runs}</span></div>
      <div class="flex justify-between"><span class="text-slate-400">Ops Executed:</span><span class="text-amber-400 font-bold">17</span></div>
      <div class="flex justify-between"><span class="text-slate-400">Caps Executed:</span><span class="text-purple-400 font-bold">40</span></div>
      <div class="flex justify-between"><span class="text-slate-400">Timestamp:</span><span class="text-sky-400 mono">${fmtDate(updated.lastRun)}</span></div>
    </div>
  `);
  render();
}

