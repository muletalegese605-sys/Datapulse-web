              <td data-l="Auto" class="p-3">${faOn ? `<span class="autobadge" title="${faStats.runs||0} runs · ${faStats.capsRun||40}c/${faStats.opsRun||17}o">⚡ ON</span>` : `<span class="text-[10px] text-slate-500">—</span>`}</td>
