    ChartLib.defaults.color = ADM.theme.current()==='dark' ? '#94a3b8' : '#475569';
    var days = 14, labels = [], signupsByDay = [], actionsByDay = [];
    for (var i = days - 1; i >= 0; i--) {
      var d = new Date(Date.now() - i * 86400000);
      var key = d.toISOString().slice(0,10);
      labels.push(d.toLocaleDateString('en-GB', { day:'2-digit', month:'short' }));
      var dayAudits = state.audits.filter(function(a){ return (a.at||a.performed_at||'').slice(0,10) === key; });
      signupsByDay.push(dayAudits.filter(function(a){ return a.action === 'ORG_CREATE'; }).length);
      actionsByDay.push(dayAudits.filter(function(a){ return !/LOGIN|LOGOUT/.test(a.action); }).length);
    }
    var tc = document.getElementById('measureTrendChart');
    if (tc) {
      state.measureChart = new ChartLib(tc, {
        type: 'line',
        data: { labels: labels, datasets: [
          { label: 'Signups', data: signupsByDay, borderColor:'#a855f7', backgroundColor:'rgba(168,85,247,.15)', fill:true, tension:.4, borderWidth:2.5, pointRadius:3 },
          { label: 'Actions', data: actionsByDay, borderColor:'#10b981', backgroundColor:'rgba(16,185,129,.15)', fill:true, tension:.4, borderWidth:2.5, pointRadius:3 }
        ]},
        options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ position:'bottom', labels:{boxWidth:10, font:{size:10}} } } }
      });
    }
    var audits = state.audits.slice(0, 500);
    var byAction = {};
    audits.forEach(function(a){ byAction[a.action] = (byAction[a.action]||0) + 1; });
    var topEvents = Object.entries(byAction).sort(function(a,b){ return b[1]-a[1]; }).slice(0, 8);
    var ec = document.getElementById('measureEventsChart');
    if (ec) {
      state.charts.events = new ChartLib(ec, {
        type: 'bar',
        data: { labels: topEvents.map(function(e){ return e[0].slice(0, 20); }), datasets: [{ label:'Count', data: topEvents.map(function(e){ return e[1]; }), backgroundColor:['rgba(168,85,247,.7)','rgba(16,185,129,.7)','rgba(56,189,248,.7)','rgba(245,158,11,.7)','rgba(244,63,94,.7)','rgba(99,102,241,.7)','rgba(20,184,166,.7)','rgba(251,113,133,.7)'], borderRadius:5 }]},
        options: { responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false} }, indexAxis:'y' }
      });
    }
  } catch(e) { console.warn('drawMeasureCharts error:', e); }
}

ADM.measureAI = {
  generateInsights: function(o) {
    var s = o.s, conversionRate = o.conversionRate, churnRate = o.churnRate, npsScore = o.npsScore, avgRating = o.avgRating, errCount = o.errCount, feedback = o.feedback;
    var insights = [];
    if (s.totalOrgs >= 5 && parseFloat(conversionRate) < 20) insights.push({ priority:'high', color:'amber', icon:'fa-arrow-trend-up', title:'Low conversion (' + conversionRate + '%)', detail:'Only ' + s.paidOrgs + '/' + s.totalOrgs + ' orgs paying.', action:"go('contracts')", actionLabel:'Plans' });
