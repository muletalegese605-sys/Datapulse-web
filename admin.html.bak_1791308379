function restoreAllData(ev) {
  const f = ev.target.files[0]; if (!f) return;
  const reader = new FileReader();
  reader.onload = () => {
    try {
      const b = JSON.parse(reader.result);
      if (!b.data) throw new Error('Invalid backup file');
      openConfirm('Restore Backup?', `Restore from ${new Date(b.exportedAt).toLocaleString()}? Current data will be replaced.`, () => {
        state.orgs = b.data.orgs || [];
        state.contracts = b.data.contracts || [];
        state.audits = b.data.audits || [];
        state.records = b.data.records || {};
        state.fullAutoStats = b.data.fullAutoStats || {};
        persistOrgs(); persistContracts(); persistAudits(); persistFullAutoStats();
        Object.entries(state.records).forEach(([id, recs]) => LS.set('dp_records_'+id, recs));
        Object.entries(state.fullAutoStats).forEach(([id, st]) => LS.set('dp_full_auto_'+id, st));
        if (b.data.theme) LS.set('dp_theme', b.data.theme);
        if (b.data.currency) LS.set('dp_currency', b.data.currency);
        if (b.data.lang) LS.set('dp_lang', b.data.lang);
        if (b.data.backend) LS.set('dp_backend', b.data.backend);
        ADM.theme.apply(ADM.theme.current());
        ADM.i18n.init();
        ADM.currency.renderSelectors();
        auditLog('RESTORE_ALL');
        toast('Backup restored — pushing to cloud…','success');
        ADM.sync.pushAll(true).catch(() => {});
        render();
      });
    } catch(e){ toast('Restore failed: '+e.message,'error'); }
    ev.target.value = '';
  };
  reader.readAsText(f);
}
function confirmResetAll() {
  openConfirm('Reset ALL Data?', 'Deletes every organization, contract, audit entry, record, and full-auto stats from localStorage.', () => {
    LS.del('dp_orgs'); LS.del('dp_contracts'); LS.del('dp_audits'); LS.del('dp_full_auto_stats');
    const keys = [];
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && (k.startsWith('dp_records_') || k.startsWith('dp_trial_') || k.startsWith('dp_full_auto_'))) keys.push(k);
    }
    keys.forEach(k => LS.del(k));
    state.orgs = []; state.contracts = []; state.audits = []; state.records = {}; state.fullAutoStats = {};
    toast('All local data reset','warn');
    render();
  });
}

/* ---------- BACKEND HEALTH ---------- */
async function checkBackendHealth(verbose) {
  if (state.backendChecking) return;
  state.backendChecking = true;
  const url = (document.getElementById('backendUrl')?.value || BACKEND_URL).trim().replace(/\/$/,'');
  const dot = document.getElementById('backendDot');
  const st = document.getElementById('backendStatus');
  const icon = document.getElementById('syncIcon');
  if (icon) icon.classList.add('fa-spin');
  if (dot) dot.className = 'w-2 h-2 rounded-full bg-amber-400 pulse-dot';
  if (st) st.textContent = '(checking…)';
  let connected = false;
  const t0 = performance.now();
  for (const ep of ['/health','/health_check','/api/health','/ping','/']) {
    if (performance.now() - t0 > 10000) break;
    try {
      const ctrl = new AbortController();
      const to = setTimeout(() => ctrl.abort(), ADM.config.healthTimeout);
      const res = await fetch(url + ep, { method:'GET', mode:'cors', credentials:'omit', signal: ctrl.signal });
      clearTimeout(to);
      if (res.ok || res.status === 204 || res.status === 401 || res.status === 403) { connected = true; break; }
    } catch(e){ /* silent */ }
  }
  state.backendOnline = connected;
  if (connected) { if (dot) dot.className='w-2 h-2 rounded-full bg-emerald-400 pulse-dot'; if (st) st.textContent='CONNECTED'; if (verbose) toast('Backend connected ✓','success'); }
  else { if (dot) dot.className='w-2 h-2 rounded-full bg-rose-400'; if (st) st.textContent='OFFLINE'; if (verbose) toast('Backend offline — running local mode (data saved)','info'); }
  if (icon) icon.classList.remove('fa-spin');
  state.backendChecking = false;
  if (state.tab === 'settings' || state.tab === 'sync') render();
  return connected;
}
async function syncBackend() {
  const url = document.getElementById('backendUrl').value.trim();
  LS.set('dp_backend', url);
  ADM.config.backendDefault = url;
  await checkBackendHealth(true);
  await ADM.sync.flushQueue();
  await ADM.sync.pushAll(false);
}

